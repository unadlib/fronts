{
  "name": "@fronts/website",
  "version": "2.0.0-alpha.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "pnpm check:content && pnpm typecheck && pnpm build && pnpm check:output && pnpm test:e2e",
    "check:content": "pnpm sync && node scripts/check-content.mjs",
    "check:output": "node scripts/check-output.mjs",
    "clean": "rm -rf .next .source content/docs out tsconfig.tsbuildinfo",
    "dev": "next dev --port 4300",
    "prebuild": "pnpm sync",
    "predev": "pnpm sync",
    "start": "serve out -l 4300",
    "sync": "node scripts/sync-content.mjs",
    "test:e2e": "playwright test --config playwright.config.ts",
    "typecheck": "pnpm sync && fumadocs-mdx && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@fumadocs/language": "^0.2.0",
    "@orama/orama": "^3.1.18",
    "@orama/tokenizers": "^3.1.18",
    "cnfast": "^0.0.8",
    "fumadocs-core": "^16.11.4",
    "fumadocs-mdx": "^15.1.1",
    "fumadocs-ui": "npm:@fumadocs/base-ui@^16.11.4",
    "lucide-react": "^1.24.0",
    "mermaid": "^11.16.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.17",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3"
  }
}
