page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#supported-versions","content":"Fronts 2.0 has not yet been published. Security reports against the current `master` implementation\nare welcome, but there is no shipped 2.0 release to patch today."},"626":{"id":"/en/docs/operations/security-54","page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#supported-versions","content":"Version line"},"627":{"id":"/en/docs/operations/security-55","page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#supported-versions","content":"Security status"},"628":{"id":"/en/docs/operations/security-56","page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#supported-versions","content":"Current unreleased 2.0"},"629":{"id":"/en/docs/operations/security-57","page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#supported-versions","content":"Reports accepted; fixes land on `master`."},"630":{"id":"/en/docs/operations/security-58","page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#supported-versions","content":"Published 2.0 prerelease"},"631":{"id":"/en/docs/operations/security-59","page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#supported-versions","content":"None yet. After publication, only the newest `next` prerelease is intended to receive fixes."},"632":{"id":"/en/docs/operations/security-60","page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#supported-versions","content":"Stable 2.x"},"633":{"id":"/en/docs/operations/security-61","page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#supported-versions","content":"None yet. A stable maintenance window must be accepted before `latest`."},"634":{"id":"/en/docs/operations/security-62","page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#supported-versions","content":"Earlier package lines"},"635":{"id":"/en/docs/operations/security-63","page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#supported-versions","content":"Unsupported by this repository policy."},"636":{"id":"/en/docs/operations/security-64","page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#supported-versions","content":"The support policy owns runtime and compatibility boundaries. This table\nmust be updated as part of every release-line or maintenance-policy change."},"637":{"id":"/en/docs/operations/security-65","page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#researcher-expectations","content":"Researchers must:"},"638":{"id":"/en/docs/operations/security-66","page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#researcher-expectations","content":"test only systems and data they own or are authorized to assess;"},"639":{"id":"/en/docs/operations/security-67","page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#researcher-expectations","content":"minimize access, collection, and retention of data;"},"640":{"id":"/en/docs/operations/security-68","page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#researcher-expectations","content":"stop when a test could affect availability, other users, or production integrity;"},"641":{"id":"/en/docs/operations/security-69","page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#researcher-expectations","content":"avoid social engineering, physical attacks, credential stuffing, destructive tests, and\nunbounded denial of service;"},"642":{"id":"/en/docs/operations/security-70","page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#researcher-expectations","content":"keep the report private until the maintainers and reporter coordinate disclosure;"},"643":{"id":"/en/docs/operations/security-71","page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#researcher-expectations","content":"give maintainers a reasonable opportunity to reproduce, remediate, and publish an advisory."},"644":{"id":"/en/docs/operations/security-72","page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#researcher-expectations","content":"This policy does not grant access to third-party systems or make a legal safe-harbor promise. Obtain\nindependent authorization when needed."},"645":{"id":"/en/docs/operations/security-73","page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#maintainer-response-process","content":"Maintainers handling a private report SHOULD:"},"646":{"id":"/en/docs/operations/security-74","page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#maintainer-response-process","content":"acknowledge it in the private advisory and assign an owner;"},"647":{"id":"/en/docs/operations/security-75","page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#maintainer-response-process","content":"reproduce against a supported or release-candidate configuration;"},"648":{"id":"/en/docs/operations/security-76","page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#maintainer-response-process","content":"identify the violated trust boundary and affected package/version range;"},"649":{"id":"/en/docs/operations/security-77","page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#maintainer-response-process","content":"assess confidentiality, integrity, availability, required privileges, and exploitability;"},"650":{"id":"/en/docs/operations/security-78","page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#maintainer-response-process","content":"add a regression test that fails before the fix whenever safe and practical;"},"651":{"id":"/en/docs/operations/security-79","page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#maintainer-response-process","content":"prepare the fix in the private advisory fork or another access-controlled branch;"},"652":{"id":"/en/docs/operations/security-80","page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#maintainer-response-process","content":"verify package tarballs, lifecycle cleanup, relevant browser E2E, and rollback;"},"653":{"id":"/en/docs/operations/security-81","page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#maintainer-response-process","content":"coordinate release timing, advisory text, credit, and CVE request when appropriate;"},"654":{"id":"/en/docs/operations/security-82","page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#maintainer-response-process","content":"publish fixed packages and the advisory together, then update supported-version information;"},"655":{"id":"/en/docs/operations/security-83","page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#maintainer-response-process","content":"review whether architecture, threat-model, runbook, or deployment guidance must change."},"656":{"id":"/en/docs/operations/security-84","page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#maintainer-response-