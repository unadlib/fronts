/isolation-security-25","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#container-comparison","content":"Trusted apps sharing a design system"},"1402":{"id":"/en/docs/runtime/isolation-security-26","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#container-comparison","content":"Shadow DOM"},"1403":{"id":"/en/docs/runtime/isolation-security-27","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#container-comparison","content":"Strong selector boundary, with known escape/inheritance limits"},"1404":{"id":"/en/docs/runtime/isolation-security-28","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#container-comparison","content":"None"},"1405":{"id":"/en/docs/runtime/isolation-security-29","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#container-comparison","content":"Direct scoped object"},"1406":{"id":"/en/docs/runtime/isolation-security-30","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#container-comparison","content":"Trusted code requiring style containment"},"1407":{"id":"/en/docs/runtime/isolation-security-31","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#container-comparison","content":"iframe"},"1408":{"id":"/en/docs/runtime/isolation-security-32","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#container-comparison","content":"Document/origin boundary"},"1409":{"id":"/en/docs/runtime/isolation-security-33","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#container-comparison","content":"Separate realm; strength depends on `sandbox` and origin"},"1410":{"id":"/en/docs/runtime/isolation-security-34","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#container-comparison","content":"Scoped RPC"},"1411":{"id":"/en/docs/runtime/isolation-security-35","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#container-comparison","content":"Lower-trust or incompatible applications"},"1412":{"id":"/en/docs/runtime/isolation-security-36","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#container-comparison","content":"Official Module Federation deliberately does not provide automatic CSS isolation and recommends\nproducer-owned strategies because shared dependencies and runtime CSS capture create ambiguous\nownership. Fronts follows that rule. Its Shadow container supplies a target; it does not scrape or\nmove styles injected into the parent document. See the official\nstyle isolation guidance."},"1413":{"id":"/en/docs/runtime/isolation-security-37","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#dom-container","content":"The DOM adapter creates an owned child element with the configured tag name, class, attributes,\nand Fronts application identity data. Browser DOM APIs validate those values; Fronts does not\nclaim a same-realm security allowlist for generic DOM attributes. The application mounts inside\nthe element. Unmount destroys the application first, then removes the owned element."},"1414":{"id":"/en/docs/runtime/isolation-security-38","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#dom-container","content":"DOM mode is appropriate only when producer code is trusted to share the page. The application can\nstill access `window`, `document`, cookies available to the page, and other DOM outside its target."},"1415":{"id":"/en/docs/runtime/isolation-security-39","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#shadow-dom-container","content":"The Shadow adapter creates a host element and attaches an open or closed shadow root. Producer\nstyles must be authored for Shadow DOM: inline style, constructable stylesheet, CSS-in-JS aimed at\nthe shadow root, or an exported custom element."},"1416":{"id":"/en/docs/runtime/isolation-security-40","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#shadow-dom-container","content":"Shadow DOM does not isolate:"},"1417":{"id":"/en/docs/runtime/isolation-security-41","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#shadow-dom-container","content":"JavaScript globals or network access;"},"1418":{"id":"/en/docs/runtime/isolation-security-42","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#shadow-dom-container","content":"inherited CSS custom properties and inheritable properties;"},"1419":{"id":"/en/docs/runtime/isolation-security-43","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#shadow-dom-container","content":"browser APIs such as storage;"},"1420":{"id":"/en/docs/runtime/isolation-security-44","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#shadow-dom-container","content":"portals that intentionally render outside the shadow root;"},"1421":{"id":"/en/docs/runtime/isolation-security-45","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#shadow-dom-container","content":"shared singleton state."},"1422":{"id":"/en/docs/runtime/isolation-security-46","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#shadow-dom-container","content":"Treat it as style/DOM encapsulation, not a hostile-code boundary."},"1423":{"id":"/en/docs/runtime/isolation-security-47","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#iframe-container-and-agent","content":"Iframe mode divides responsibility:"},"1424":{"id":"/en/docs/runtime/isolation-security-48","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#iframe-container-and-agent","content":"parent: resolve policy, create iframe, authorize capabilities, proxy lifecycle calls;"},"1425":{"id":"/en/docs/runtime/isolation-security-49","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#iframe-container-and-agent","content":"child agent: own a separate MF instance, load/validate/mount the application, and operate on the\nchild document;"},"1426":{"id":"/en/docs/runtime/isolation-security-50","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#iframe-container-and-agent","content":"RPC channel: correlate requests by unpredictable channel ID and protocol version."},"1427":{"id":"/en/docs/runtime/isolation-security-51","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#iframe-container-and-agent","content":"Required controls:"},"1428":{"id":"/en/docs/runtime/isolation-security-52","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#iframe-container-and-agent","content":"exact `targetOrigin`; wildcard origins are rejected;"},"1429":{"id":"/en/docs/runtime/isolation-security-53","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#iframe-container-and-agent","content":"transfer of a dedicated MessagePort only in that connect message, plus child-side validation of\nits sender `origin` and `source`;"},"1430":{"id":"/en/docs/runtime/isolation-security-54","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#iframe-container-and-agent","content":"an allowlist of parent origins in the agent;"},"1431":{"id":"/en/docs/runtime/isolation-security-55","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#iframe-container-and-agent","content":"an iframe sandbox that preserves the dedicated child origin so the connect message can retain\nan exact `targetOrigin`;"},"1432":{"id":"/en/docs/runtime/isolation-security-56","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#iframe-container-and-agent","content":"an explicit `allow` policy chosen by the host;"},"1433":{"id":"/en/docs/runtime/isolation-security-57","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#iframe-container-and-agent","content":"one-time capability negotiation after the child application is loaded;"},"1434":{"id":"/en/docs/runtime/isolation-security-58","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#iframe-container-and-agent","content":"negotiated capability and method validation on every host invocation;"},"1435":{"id":"/en/docs/runtime/isolation-security-59","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#iframe-container-and-agent","content":"serializable arguments/results only;"},"1436":{"id":"/en/docs/runtime/isolation-security-60","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#iframe-container-and-agent","content":"finite, configurable connection and lifecycle timeout values (`0` explicitly disables a\ndeadline);"},"1437":{"id":"/en/docs/runtime/isolation-security-61","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#iframe-container-and-agent","content":"channel teardown and pending-promise rejection on dispose."},"1438":{"id":"/en/docs/runtime/isolation-security-62","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#iframe-container-and-agent","content":"The iframe agent creates its own Module Federation instance. This prevents the parent from\nevaluating the remote and then pretending an iframe provides isolation. Shared dependencies are\ntherefore scoped to the child runtime, trading some duplication for realm isolation."},"1439":{"id":"/en/docs/runtime/isolation-security-63","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#sandbox-and-origin-choice","content":"The origin-bound agent transport requires both `allow-scripts` and `allow-same-origin`: an opaque\nsandbox origin cannot receive a connect message addressed to the deployment's exact origin, and\nFronts will not weaken that bootstrap to `targetOrigin=\"*\"`. Fronts therefore requires the agent to\nbe served from a dedicated origin different from the host document and rejects sandbox options\nthat omit either token. On a cross-origin deployment, `allow-same-origin` preserves the child's own\norigin; it does not grant access to the parent origin. Never move that configuration onto the host\norigin, where script plus preserved origin can let the child escape sandbox restrictions."},"1440":{"id":"/en/docs/runtime/isolation-security-64","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#sandbox-and-origin-choice","content":"The iframe container defaults to `sandbox=\"allow-same-origin allow-scripts\"`. Grant additional\nbrowser permissions (`allow`) and sandbox tokens individually. Content Security Policy, Trusted\nTypes, COOP/COEP, cookie attributes, and server headers remain deployment responsibilities.\nGeneric iframe `attributes` cannot override dedicated options (`src`, `sandbox`, `allow`, and the\nother typed fields), Fronts-owned `data-fronts-*` state, or inline `on*` event handlers."},"1441":{"id":"/en/docs/runtime/isolation-security-65","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#capability-scoped-services","content":"Producer declaration:"},"1442":{"id":"/en/docs/runtime/isolation-security-66","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#capability-scoped-services","content":"Host authorization:"},"1443":{"id":"/en/docs/runtime/isolation-security-67","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#capability-scoped-services","content":"The signal also bounds asynchronous authorization work; an aborted mount stops waiting for the\npolicy before any service facade reaches the application."},"1444":{"id":"/en/docs/runtime/isolation-security-68","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#capability-scoped-services","content":"For identity-, tenant-, deployment-, or trace-bound implementations, configure `createServices`.\nIt receives trusted host identity, operation, resolution policy, resolved deployment, declared\ncapabilities, and the instance signal, and may return an asynchronous disposer. Static and\nprovider services are merged, with provider values taking precedence, before policy evaluation."},"1445":{"id":"/en/docs/runtime/isolation-security-69","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#capability-scoped-services","content":"The resulting scope exposes only allowed own keys. Prototype-mutating names are rejected. Service\nobjects are proxied and revoked immediately on abort or unmount; provider resources are then\ndisposed exactly once as lifecycle cleanup proceeds."},"1446":{"id":"/en/docs/runtime/isolation-security-70","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#capability-scoped-services","content":"Iframe authority is the intersection of three sets:"},"1447":{"id":"/en/docs/runtime/isolation-security-71","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#capability-scoped-services","content":"the maximum configured by `IframeProxyLoaderOptions.capabilities`;"},"1448":{"id":"/en/docs/runtime/isolation-security-72","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#capability-scoped-services","content":"services actually present in the host-authorized instance facade;"},"1449":{"id":"/en/docs/runtime/isolation-security-73","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#capability-scoped-services","content":"capabilities declared by the application loaded inside the child."},"1450":{"id":"/en/docs/runtime/isolation-security-74","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#capability-scoped-services","content":"The first set is an upper bound, not a mandatory dependency declaration for the proxy. Before the\niframe handshake, the host removes entries that are unavailable from the instance provider or\ndenied by policy. The child still requires its complete declared set from the resulting offer."},"1451":{"id":"/en/docs/runtime/isolation-security-75","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#capability-scoped-services","content":"Iframe protocol v2 requires the agent to send the third set after loading the real application.\nThe parent validates the intersection, locks one grant for that session, and the child creates RPC\nstubs only for that exact grant. The parent independently checks the locked grant again on every\n`service.call`; hiding extra stubs in the child is not treated as the security boundary. A call\nbefore negotiation, a repeated negotiation, or a call outside the grant fails closed. The child\nnever receives an original host service object."},"1452":{"id":"/en/docs/runtime/isolation-security-76","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#capability-scoped-services","content":"Guidelines:"},"1453":{"id":"/en/docs/runtime/isolation-security-77","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#capability-scoped-services","content":"expose intent, not ambient authority;"},"1454":{"id":"/en/docs/runtime/isolation-security-78","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#capability-scoped-services","content":"validate service arguments in the host implementation;"},"1455":{"id":"/en/docs/runtime/isolation-security-79","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#capability-scoped-services","content":"include identity/tenant context server-side instead of trusting child-supplied identity;"},"1456":{"id":"/en/docs/runtime/isolation-security-80","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#capability-scoped-services","content":"rate-limit expensive or sensitive methods;"},"1457":{"id":"/en/docs/runtime/isolation-security-81","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#capability-scoped-services","content":"never expose raw auth tokens, storage, `fetch`, DOM roots, or a generic `eval/execute` service;"},"1458":{"id":"/en/docs/runtime/isolation-security-82","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#capability-scoped-services","content":"log denied capability requests and privileged calls."},"1459":{"id":"/en/docs/runtime/isolation-security-83","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#capability-scoped-services","content":"make providers abort-aware and roll back partial allocation when they throw before returning; a\nresult that arrives after host cancellation is disposed by the host."},"1460":{"id":"/en/docs/runtime/isolation-security-84","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#supply-chain-checklist","content":"HTTPS for registry, manifests, entries, chunks, and iframe agent."},"1461":{"id":"/en/docs/runtime/isolation-security-85","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#supply-chain-checklist","content":"Immutable versioned URLs and restrictive CDN write permissions."},"1462":{"id":"/en/docs/runtime/isolation-security-86","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#supply-chain-checklist","content":"Artifact signing/attestation in the deployment pipeline."},"1463":{"id":"/en/docs/runtime/isolation-security-87","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#supply-chain-checklist","content":"CSP with explicit script/connect/frame origins; nonce/hash where applicable."},"1464":{"id":"/en/docs/runtime/isolation-security-88","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#supply-chain-checklist","content":"Registry responses authenticated and authorized; browser query inputs are untrusted."},"1465":{"id":"/en/docs/runtime/isolation-security-89","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#supply-chain-checklist","content":"Dependency and license scanning for producers and host."},"1466":{"id":"/en/docs/runtime/isolation-security-90","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#supply-chain-checklist","content":"Retain previous immutable artifacts for rollback."},"1467":{"id":"/en/docs/runtime/isolation-security-91","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#supply-chain-checklist","content":"Correlate registry deployment ID, MF loading trace, and Fronts trace ID."},"1468":{"id":"/en/docs/runtime/isolation-security-92","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#non-goals","content":"Fronts does not implement SES, Realms, DOM membrane virtualization, network interception, or a\ncomplete browser sandbox. Use a hardened cross-origin iframe or a separate application boundary\nwhen code is not trusted."},"1469":{"id":"/en/docs/runtime/isolation-security-93","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#verification","content":"`pnpm exec vitest run packages/core/test/container.test.ts packages/core/test/services.test.ts`\nverifies DOM/Shadow ownership, capability filtering, revocation, and provider cleanup."},"1470":{"id":"/en/docs/runtime/isolation-security-94","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#verification","content":"`pnpm exec vitest run packages/core/test/iframe.test.ts` verifies origin/source validation,\nchannel negotiation, RPC grants, cancellation, and cleanup."},"1471":{"id":"/en/docs/runtime/isolation-security-95","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#verification","content":"`pnpm test:e2e` and `pnpm test:e2e:preview` exercise the cross-origin iframe boundary in a real\nChromium browser."},"1472":{"id":"/en/docs/runtime/isolation-security-96","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#verification","content":"Iframe deployment defines the production wiring and CSP checklist."},"1473":{"id":"/en/docs/runtime/module-federation","page_id":"/en/docs/runtime/module-federation","type":"page","content":"Module Federation Integrations","breadcrumbs":["Fronts 2.0 Documentation","Runtime guides","Runtime guides"],"tags":[],"url":"/en/docs/runtime/module-federation"},"1474":{"id":"/en/docs/runtime/module-federation-0","page_id":"/en/docs/runtime/module-federation","tags":[],"type":"text","url":"/en/docs/runtime/module-federation","content":"Supported ownership boundary, producer compatibility tiers, and verification paths for Module Federation delivery."},"1475":{"id":"/en/docs/runtime/module-federation-1","page_id":"/en/docs/runtime/module-federation","type":"heading","tags":[],"url":"/en/docs/runtime/module-federation#purpose","content":"Purpose"},"1476":{"id":"/en/docs/runtime/module-federation-2","page_id":"/en/docs/runtime/module-federation","type":"heading","tags":[],"url":"/en/docs/runtime/module-federation#ownership-boundary","content":"Ownership boundary"},"1477":{"id":"/en/docs/runtime/module-federation-3","page_id":"/en/docs/runtime/module-federation","type":"heading","tags":[],"url":"/en/docs/runtime/module-federation#compatibility-vocabulary","content":"Compatibility vocabulary"},"1478":{"id":"/en/docs/runtime/module-federation-4","page_id":"/en/docs/runtime/module-federation","type":"heading","tags":[],"url":"/en/docs/runtime/module-federation#integration-matrix","content":"Integration matrix"},"1479":{"id":"/en/docs/runtime/module-federation-5","page_id":"/en/docs/runtime/module-federation","type":"heading","tags":[],"url":"/en/docs/runtime/module-federation#official-rsbuild-and-vite-producers","content":"Official Rsbuild and Vite producers"},"1480":{"id":"/en/docs/runtime/module-federation-6","page_id":"/en/docs/runtime/module-federation","type":"heading","tags":[],"url":"/en/docs/runtime/module-federation#vite-plugin-federation","content":"`vite-plugin-federation`"},"1481":{"id":"/en/docs/runtime/module-federation-7","page_id":"/en/docs/runtime/module-federation","type":"heading","tags":[],"url":"/en/docs/runtime/module-federation#originjs","content":"OriginJS"},"1482":{"id":"/en/docs/runtime/module-federation-8","page_id":"/en/docs/runtime/module-federation","type":"heading","tags":[],"url":"/en/docs/runtime/module-federation#dependency-choices","content":"Dependency choices"},"1483":{"id":"/en/docs/runtime/module-federation-9","page_id":"/en/docs/runtime/module-federation","type":"heading","tags":[],"url":"/en/docs/runtime/module-federation#adding-another-producer","content":"Adding another producer"},"1484":{"id":"/en/docs/runtime/module-federation-10","page_id":"/en/docs/runtime/module-federation","type":"heading","tags":[],"url":"/en/docs/runtime/module-federation#verification","content":"Verification"},"1485":{"id":"/en/docs/runtime/module-federation-11","page_id":"/en/docs/runtime/module-federation","type":"heading","tags":[],"url":"/en/docs/runtime/module-federation#related-documentation","content":"Related documentation"},"1486":{"id":"/en/docs/runtime/module-federation-12","page_id":"/en/docs/runtime/module-federation","type":"heading","tags":[],"url":"/en/docs/runtime/module-federation#citations","content":"Citations"},"1487":{"id":"/en/docs/runtime/module-federation-13","page_id":"/en/docs/runtime/module-federation","tags":[],"type":"text","url":"/en/docs/runtime/module-federation#purpose","content":"This document defines what Fronts supports when Module Federation is selected as an application\ndelivery transport. It distinguishes a supported Fronts runtime contract from a producer artifact\nthat happens to be interoperable in one tested configuration."},"1488":{"id":"/en/docs/runtime/module-federation-14","page_id":"/en/docs/runtime/module-federation","tags":[],"type":"text","url":"/en/docs/runtime/module-federation#purpose","content":"Fronts core does not require Module Federation. `@fronts/mf` is an adapter over an explicitly\nsupplied official Module Federation runtime instance; it does not implement another manifest\nparser, share resolver, remote registry, or bundler plugin."},"1489":{"id":"/en/docs/runtime/module-federation-15","page_id":"/en/docs/runtime/module-federation","tags":[],"type":"text","url":"/en/docs/runtime/module-federation#ownership-boundary","content":"This shows the stable ownership boundary: Fronts selects a deployment and governs its application\nlifecycle, while the official runtime owns remote registration, manifest interpretation, exposed\nmodule loading, and shared dependencies."},"1490":{"id":"/en/docs/runtime/module-federation-16","page_id":"/en/docs/runtime/module-federation","tags":[],"type":"text","url":"/en/docs/runtime/module-federation#ownership-boundary","content":"Rules:"},"1491":{"id":"/en/docs/runtime/module-federation-17","page_id":"/en/docs/runtime/module-federation","tags":[],"type":"text","url":"/en/docs/runtime/module-federation#ownership-boundary","content":"A Fronts Host using MF MUST pass an explicit official runtime instance to `@fronts/mf`."},"1492":{"id":"/en/docs/runtime/module-federation-18","page_id":"/en/docs/runtime/module-federation","tags":[],"type":"text","url":"/en/docs/runtime/module-federation#ownership-boundary","content":"A producer MUST expose a valid `FrontsApp`, normally as `./application`; exposing a React or Vue\ncomponent alone does not satisfy the Fronts application contract."},"1493":{"id":"/en/docs/runtime/module-federation-19","page_id":"/en/docs/runtime/module-federation","tags":[],"type":"text","url":"/en/docs/runtime/module-federation#ownership-boundary","content":"Fronts MUST NOT depend on a producer plugin's private or virtual Host API."},"1494":{"id":"/en/docs/runtime/module-federation-20","page_id":"/en/docs/runtime/module-federation","tags":[],"type":"text","url":"/en/docs/runtime/module-federation#ownership-boundary","content":"Shared dependency selection remains an MF concern. Fronts MUST NOT infer or rewrite a producer's\nshare graph."},"1495":{"id":"/en/docs/runtime/module-federation-21","page_id":"/en/docs/runtime/module-federation","tags":[],"type":"text","url":"/en/docs/runtime/module-federation#ownership-boundary","content":"A deployment SHOULD use an immutable MF remote name. Rebinding one name to another source without\nexplicit force is rejected because the official runtime caches registrations and loaded modules."},"1496":{"id":"/en/docs/runtime/module-federation-22","page_id":"/en/docs/runtime/module-federation","tags":[],"type":"text","url":"/en/docs/runtime/module-federation#ownership-boundary","content":"The public adapter boundary is defined by\n`ModuleFederationInstance` and implemented through public instance\nmethods in `adapter.ts`."},"1497":{"id":"/en/docs/runtime/module-federation-23","page_id":"/en/docs/runtime/module-federation","tags":[],"type":"text","url":"/en/docs/runtime/module-federation#compatibility-vocabulary","content":"Tier"},"1498":{"id":"/en/docs/runtime/module-federation-24","page_id":"/en/docs/runtime/module-federation","tags":[],"type":"text","url":"/en/docs/runtime/module-federation#compatibility-vocabulary","content":"Meaning"},"1499":{"id":"/en/docs/runtime/module-federation-25","page_id":"/en/docs/runtime/module-federation","tags":[],"type":"text","url":"/en/docs/runtime/module-federation#compatibility-vocabulary","content":"Core-native"},"1500":{"id":"/en/docs/runtime/module-federation-26","page_id":"/en/docs/runtime/module-federation","tags":[],"type":"text","url":"/en/docs/runtime/module-federation#compatibility-vocabulary","content":"No MF dependency. A custom `AppLoader` supplies the same Fronts application protocol."},"1501":{"id":"/en/docs/runtime/module-federation-27","page_id":"/en/docs/runtime/module-federation","tags":[],"type":"text","url":"/en/docs/runtime/module-federation#compatibility-vocabulary","content":"Official integration"},"1502":{"id":"/en/docs/runtime/module-federation-28","page_id":"/en/docs/runtime/module-federation","tags":[],"type":"text","url":"/en/docs/runtime/module-federation#compatibility-vocabulary","content":"Official Module Federation runtime plus an official producer plugin, covered by repository integration and E2E tests."},"1503":{"id":"/en/docs/runtime/module-federation-29","page_id":"/en/docs/runtime/module-federation","tags":[],"type":"text","url":"/en/docs/runtime/module-federation#compatibility-vocabulary","content":"Verified producer compatibility"},"1504":{"id":"/en/docs/runtime/module-federation-30","page_id":"/en/docs/runtime/module-federation","tags":[],"type":"text","url":"/en/docs/runtime/module-federation#compatibility-vocabulary","content":"A third-party producer artifact is consumed by the official runtime and passes the documented Fronts E2E lifecycle."},"1505":{"id":"/en/docs/runtime/module-federation-31","page_id":"/en/docs/runtime/module-federation","tags":[],"type":"text","url":"/en/docs/runtime/module-federation#compatibility-vocabulary","content":"Narrow compatibility fixture"},"1506":{"id":"/en/docs/runtime/module-federation-32","page_id":"/en/docs/runtime/module-federation","tags":[],"type":"text","url":"/en/docs/runtime/module-federation#compatibility-vocabulary","content":"Only the checked-in version, output format, and execution mode are claimed. It is not a general plugin support promise."},"1507":{"id":"/en/docs/runtime/module-federation-33","page_id":"/en/docs/runtime/module-federation","tags":[],"type":"text","url":"/en/docs/runtime/module-federation#compatibility-vocabulary","content":"“Verified” means that the repository proves the stated path. It does not transfer ownership of the\nproducer plugin to Fronts or promise compatibility with every version and output format."},"1508":{"id":"/en/docs/runtime/module-federation-34","page_id":"/en/docs/runtime/module-federation","tags":[],"type":"text","url":"/en/docs/runtime/module-federation#integration-matrix","content":"Delivery path"},"1509":{"id":"/en/docs/runtime/module-federation-35","page_id":"/en/docs/runtime/module-federation","tags":[],"type":"text","url":"/en/docs/runtime/module-federation#integration-matrix","content":"Host-side loader"},"1510":{"id":"/en/docs/runtime/module-federation-36","page_id":"/en/docs/runtime/module-federation","tags":[],"type":"text","url":"/en/docs/runtime/module-federation#integration-matrix","content":"Producer artifact"},"1511":{"id":"/en/docs/runtime/module-federation-37","page_id":"/en/docs/runtime/module-federation","tags":[],"type":"text","url":"/en/docs/runtime/module-federation#integration-matrix","content":"Development path"},"1512":{"id":"/en/docs/runtime/module-federation-38","page_id":"/en/docs/runtime/module-federation","tags":[],"type":"text","url":"/en/docs/runtime/module-federation#integration-matrix","content":"Production preview"},"1513":{"id":"/en/docs/runtime/module-federation-39","page_id":"/en/docs/runtime/module-federation","tags":[],"type":"text","url":"/en/docs/runtime/module-federation#integration-matrix","content":"Tier"},"1514":{"id":"/en/docs/runtime/module-federation-40","page_id":"/en/docs/runtime/module-federation","tags":[],"type":"text","