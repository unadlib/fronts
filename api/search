-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#timeouts-and-cancellation","content":"Deadline"},"1328":{"id":"/en/docs/runtime/iframe-deployment-69","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#timeouts-and-cancellation","content":"Owner"},"1329":{"id":"/en/docs/runtime/iframe-deployment-70","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#timeouts-and-cancellation","content":"Covers"},"1330":{"id":"/en/docs/runtime/iframe-deployment-71","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#timeouts-and-cancellation","content":"Host `readyTimeoutMs`"},"1331":{"id":"/en/docs/runtime/iframe-deployment-72","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#timeouts-and-cancellation","content":"`createFrontsHost` / `mount()`"},"1332":{"id":"/en/docs/runtime/iframe-deployment-73","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#timeouts-and-cancellation","content":"The complete application mount and readiness transaction."},"1333":{"id":"/en/docs/runtime/iframe-deployment-74","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#timeouts-and-cancellation","content":"`handshakeTimeoutMs`"},"1334":{"id":"/en/docs/runtime/iframe-deployment-75","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#timeouts-and-cancellation","content":"Parent iframe proxy"},"1335":{"id":"/en/docs/runtime/iframe-deployment-76","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#timeouts-and-cancellation","content":"Frame load and child-agent readiness handshake."},"1336":{"id