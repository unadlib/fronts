:"/en/docs/runtime/isolation-security#supply-chain-checklist","content":"Supply-chain checklist"},"1385":{"id":"/en/docs/runtime/isolation-security-9","page_id":"/en/docs/runtime/isolation-security","type":"heading","tags":[],"url":"/en/docs/runtime/isolation-security#non-goals","content":"Non-goals"},"1386":{"id":"/en/docs/runtime/isolation-security-10","page_id":"/en/docs/runtime/isolation-security","type":"heading","tags":[],"url":"/en/docs/runtime/isolation-security#verification","content":"Verification"},"1387":{"id":"/en/docs/runtime/isolation-security-11","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#threat-model","content":"Fronts assumes independently delivered applications may contain defects and may have different\nlevels of trust. It reduces accidental interference and constrains explicit host APIs. It does not\nclaim that same-realm JavaScript is a security sandbox."},"1388":{"id":"/en/docs/runtime/isolation-security-12","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#threat-model","content":"Security decisions must consider three separate surfaces:"},"1389":{"id":"/en/docs/runtime/isolation-security-13","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#threat-model","content":"code provenance — what script/module is allowed to execute;"},"1390":{"id":"/en/docs/runtime/isolation-security-14","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#threat-model","content":"execution realm — what browser globals and DOM the code can reach;"},"1391":{"id":"/en/docs/runtime/isolation-security-15","page_id":"/en/docs/runtime/isolation-security","tags":[],"type":"text","url":"/en/docs/runtime/isolation-security#threat-model","content":"authority — what host operations the application can invoke."},"1392":