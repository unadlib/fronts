ions/security","tags":[],"type":"text","url":"/en/docs/operations/security#in-scope-security-boundaries","content":"accepting a forged or unsupported `FrontsApp` or iframe protocol object;"},"605":{"id":"/en/docs/operations/security-33","page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#in-scope-security-boundaries","content":"capability exposure outside the application's declared and Host-authorized service scope;"},"606":{"id":"/en/docs/operations/security-34","page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#in-scope-security-boundaries","content":"use of child-supplied identity or tenant data as trusted authorization context;"},"607":{"id":"/en/docs/operations/security-35","page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#in-scope-security-boundaries","content":"access to a revoked service facade after abort or unmount;"},"608":{"id":"/en/docs/operations/security-36","page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#in-scope-security-boundaries","content":"iframe connection acceptance from a disallowed origin or unexpected parent window;"},"609":{"id":"/en/docs/operations/security-37","page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#in-scope-security-boundaries","content":"wildcard or mismatched iframe target origin accepted by the built-in container;"},"610":{"id":"/en/docs/operations/security-38","page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#in-scope-security-boundaries","content":"escaping the configured iframe capability grant through malformed RPC messages or method names;"},"611":{"id":"/en/docs/operations/security-39","page_id":"/en/docs/operations/security","tags":[],"type":"text","url":"/en/docs/operations/security#in-scope-security-boundaries","con