very policy input;\nthe browser query is not trusted evidence of tenant or cohort membership."},"1630":{"id":"/en/docs/runtime/resolution-delivery-26","page_id":"/en/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/en/docs/runtime/resolution-delivery#resolution-aware-container-planning","content":"A mount can derive its container only after the registry returns a concrete deployment. The\nplanner runs inside the same transaction before Fronts selects a container-specific loader:"},"1631":{"id":"/en/docs/runtime/resolution-delivery-27","page_id":"/en/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/en/docs/runtime/resolution-delivery#resolution-aware-container-planning","content":"Validate registry metadata before constructing the request. Fronts snapshots the returned request,\nroutes the selected type through `containerLoaders`, and later gives the same frozen\n`ResolvedApp` to `ContainerPrepareContext`."},"1632":{"id":"/en/docs/runtime/resolution-delivery-28","page_id":"/en/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/en/docs/runtime/resolution-delivery#module-federation-source-rules","content":"`@fronts/mf` accepts the official `Remote` shape: an entry-based remote or a version-based remote.\nThe adapter:"},"1633":{"id":"/en/docs/runtime/resolution-delivery-29","page_id":"/en/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/en/docs/runtime/resolution-delivery#module-federation-source-rules","content":"registers the concrete remote on the supplied MF instance;"},"1634":{"id":"/en/docs/runtime/resolution-delivery-30","page_id":"/en/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/en/docs/runtime/resolution-delivery#module-federation-source-rules","content":"derives `remoteName/expose` from source and normalized reference;"},"1635":{"id":"/en/docs/runtime/resolution-delivery-31","page_id":"/en/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/en/docs/runtime/resolution-delivery#module-federation-source-rules","content":"calls `loadRemote(id, { from: 'runtime' })`;"},"1636":{"id":"/en/docs/runtime/resolution-delivery-32","page_id":"/en/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/en/docs/runtime/resolution-delivery#module-federation-source-rules","content":"maps null or thrown results to a Fronts load error;"},"1637":{"id":"/en/docs/runtime/resolution-delivery-33","page_id":"/en/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/en/docs/runtime/resolution-delivery#module-federation-source-rules","content":"uses `preloadRemote()` when the host requests preload;"},"1638":{"id":"/en/docs/runtime/resolution-delivery-34","page_id":"/en/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/en/docs/runtime/resolution-delivery#module-federation-source-rules","content":"rejects reuse of a remote name for a different source or known resolved version on the same MF\ninstance unless force replacement is explicit."},"1639":{"id":"/en/docs/runtime/resolution-delivery-35","page_id":"/en/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/en/docs/runtime/resolution-delivery#module-federation-source-rules","content":"Manifest is preferred over a raw remote entry because MF can discover expose assets, shared\nmetadata, type files, and preload resources. The official\nManifest/Snapshot documentation\ndescribes that asset graph. Fronts treats it as MF-owned data and never edits the global snapshot."},"1640":{"id":"/en/docs/runtime/resolution-delivery-36","page_id":"/en/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/en/docs/runtime/resolution-delivery#version-and-channel-policy","content":"Recommended registry behavior:"},"1641":{"id":"/en/docs/runtime/resolution-delivery-37","page_id":"/en/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/en/docs/runtime/resolution-delivery#version-and-channel-policy","content":"resolve a semantic range only against immutable published versions;"},"1642":{"id":"/en/docs/runtime/resolution-delivery-38","page_id":"/en/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/en/docs/runtime/resolution-delivery#version-and-channel-policy","content":"map a channel (`stable`, `canary`, `next`) to a version/deployment server-side;"},"1643":{"id":"/en/docs/runtime/resolution-delivery-39","page_id":"/en/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/en/docs/runtime/resolution-delivery#version-and-channel-policy","content":"calculate cohort allocation deterministically from authenticated subject + experiment salt;"},"1644":{"id":"/en/docs/runtime/resolution-delivery-40","page_id":"/en/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/en/docs/runtime/resolution-delivery#version-and-channel-policy","content":"return a concrete version and immutable asset URL;"},"1645":{"id":"/en/docs/runtime/resolution-delivery-41","page_id":"/en/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/en/docs/runtime/resolution-delivery#version-and-channel-policy","content":"record the policy revision/deployment ID in metadata;"},"1646":{"id":"/en/docs/runtime/resolution-delivery-42","page_id":"/en/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/en/docs/runtime/resolution-delivery#version-and-channel-policy","content":"never reuse a mutable remote name for two loaded deployments in one MF instance (the Fronts MF\nadapter also guards registrations it has observed on that instance);"},"1647":{"id":"/en/docs/runtime/resolution-delivery-43","page_id":"/en/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/en/docs/runtime/resolution-delivery#version-and-channel-policy","content":"keep the old artifact available for at least the rollback window."},"1648":{"id":"/en/docs/runtime/resolution-delivery-44","page_id":"/en/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/en/docs/runtime/resolution-delivery#version-and-channel-policy","content":"Fronts does not prescribe the registry's database or rollout algorithm. That is deployment-plane\npolicy and must remain independently operable."},"1649":{"id":"/en/docs/runtime/resolution-delivery-45","page_id":"/en/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/en/docs/runtime/resolution-delivery#cache-and-outage-behavior","content":"`createCachedResolver()` has two windows:"},"1650":{"id":"/en/docs/runtime/resolution-delivery-46","page_id":"/en/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/en/docs/runtime/resolution-delivery#cache-and-outage-behavior","content":"fresh TTL: return the cached resolution without calling the registry;"},"1651":{"id":"/en/docs/runtime/resolution-delivery-47","page_id":"/en/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/en/docs/runtime/resolution-delivery#cache-and-outage-behavior","content":"stale TTL: if refresh fails, return the previous resolution while it remains within the stale\nwindow."},"1652":{"id":"/en/docs/runtime/resolution-delivery-48","page_id":"/en/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/en/docs/runtime/resolution-delivery#cache-and-outage-behavior","content":"This is availability behavior, not silent version fallback. Emit telemetry whenever stale data is\nused, set finite windows, and ensure immutable artifacts remain available. Do not allow stale cache\nto bypass a security revocation; registries should provide a separate kill-switch path or a very\nshort TTL for sensitive applications."},"1653":{"id":"/en/docs/runtime/resolution-delivery-49","page_id":"/en/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/en/docs/runtime/resolution-delivery#preload","content":"`host.preload()` resolves the same policy and asks the transport loader to preload. It does not\nmount, create a service scope, or claim a container. MF's preload promise now reports aggregate\nresource success/failure; callers should treat rejection as an optimization failure unless product\npolicy requires the application before navigation."},"1654":{"id":"/en/docs/runtime/resolution-delivery-50","page_id":"/en/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/en/docs/runtime/resolution-delivery#safe-promotion-and-rollback","content":"Use immutable deployment URLs and Fronts replacement together:"},"1655":{"id":"/en/docs/runtime/resolution-delivery-51","page_id":"/en/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/en/docs/runtime/resolution-delivery#safe-promotion-and-rollback","content":"Registry promotes version B for the target policy cohort."},"1656":{"id":"/en/docs/runtime/resolution-delivery-52","page_id":"/en/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/en/docs/runtime/resolution-delivery#safe-promotion-and-rollback","content":"Host resolves B and mounts it in a staging slot."},"1657":{"id":"/en/docs/runtime/resolution-delivery-53","page_id":"/en/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/en/docs/runtime/resolution-delivery#safe-promotion-and-rollback","content":"B must pass protocol validation and readiness."},"1658":{"id":"/en/docs/runtime/resolution-delivery-54","page_id":"/en/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/en/docs/runtime/resolution-delivery#safe-promotion-and-rollback","content":"Host commits B and unmounts A."},"1659":{"id":"/en/docs/runtime/resolution-delivery-55","page_id":"/en/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/en/docs/runtime/resolution-delivery#safe-promotion-and-rollback","content":"If steps 2–3 fail, A remains the active instance."},"1660":{"id":"/en/docs/runtime/resolution-delivery-56","page_id":"/en/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/en/docs/runtime/resolution-delivery#safe-promotion-and-rollback","content":"Registry can demote B; future resolutions return A or a repaired C."},"1661":{"id":"/en/docs/runtime/resolution-delivery-57","page_id":"/en/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/en/docs/runtime/resolution-delivery#safe-promotion-and-rollback","content":"Avoid `registerRemotes(..., { force: true })` for routine promotion of an already active remote.\nThe official Runtime warns that force replacement clears loaded-module cache. Fronts supports the\nflag only as an explicit source/adapter option; immutable remote names plus application\nreplacement are easier to audit."},"1662":{"id":"/en/docs/runtime/resolution-delivery-58","page_id":"/en/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/en/docs/runtime/resolution-delivery#out-of-scope","content":"Fronts does not publish assets, sign manifests, generate types, run a deployment registry, or\nchoose shared dependency versions. Those remain producer/deployment/MF responsibilities."},"1663":{"id":"/en/docs/runtime/resolution-delivery-59","page_id":"/en/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/en/docs/runtime/resolution-delivery#verification","content":"`pnpm exec vitest run packages/core/test/resolver.test.ts packages/core/test/host.test.ts` verifies\nnormalization, policy snapshots, cache windows, cancellation, preload, and resolved deployments."},"1664":{"id":"/en/docs/runtime/resolution-delivery-60","page_id":"/en/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/en/docs/runtime/resolution-delivery#verification","content":"`pnpm exec vitest run packages/mf/test` verifies that concrete deployments map to public official\nRuntime registration, preload, and loading operations without taking ownership of MF policy."},"1665":{"id":"/en/docs/runtime/resolution-delivery-61","page_id":"/en/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/en/docs/runtime/resolution-delivery#verification","content":"`pnpm exec vitest run packages/core/test/replacement.test.ts` verifies safe staged promotion and\nrollback behavior after resolution."},"1666":{"id":"/en/docs/runtime/resolution-delivery-62","page_id":"/en/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/en/docs/runtime/resolution-delivery#verification","content":"Module Federation integrations defines delivery-plugin support\nseparately from the resolver contract."}},"count":1666},"sorting":{"language":"english","sortableProperties":["content","page_id","type","url"],"sortablePropertiesWithTypes":{"content":"string","page_id":"string","type":"string","url":"string"},"sorts":{"content":{"docs":{"1":1130,"2":809,"3":1061,"4":531,"5":446,"6":288,"7":1624,"8":674,"9":265,"10":1141,"11":1588,"12":499,"13":480,"14":1443,"15":671,"16":839,"17":415,"18":1160,"19":1641,"20":580,"21":694,"22":676,"23":916,"24":1560,"25":848,"26":900,"27":1279,"28":14,"29":846,"30":16,"31":369,"32":260,"33":721,"34":236,"35":682,"36":1131,"37":520,"38":337,"39":330,"40":740,"41":894,"42":1473,"43":1587,"44":1404,"45":329,"46":663,"47":1101,"48":904,"49":905,"50":186,"51":215,"52":44,"53":211,"54":1339,"55":380,"56":383,"57":657,"58":1136,"59":1630,"60":443,"61":1601,"62":616,"63":1409,"64":1398,"65":819,"66":112,"67":1375,"68":203,"69":205,"70":209,"71":248,"72":122,"73":1151,"74":1558,"75":1011,"76":1220,"77":1007,"78":314,"79":267,"80":333,"81":523,"82":1340,"83":1460,"84":1264,"85":651,"86":1070,"87":72,"88":74,"89":1498,"90":1102,"91":155,"92":166,"93":130,"94":139,"95":670,"96":1288,"97":1365,"98":542,"99":486,"100":48,"101":198,"102":199,"103":47,"104":56,"105":103,"106":104,"107":1025,"108":735,"109":1203,"110":630,"111":1602,"112":710,"113":539,"114":12,"115":22,"116":30,"117":623,"118":941,"119":241,"120":1219,"121":316,"122":264,"123":1076,"124":1415,"125":1490,"126":387,"127":871,"128":667,"129":863,"130":1026,"131":467,"132":1196,"133":1027,"134":379,"135":1324,"136":1028,"137":582,"138":1289,"139":1029,"140":866,"141":1197,"142":1030,"143":589,"144":659,"145":972,"146":1022,"147":853,"148":583,"149":1036,"150":505,"151":584,"152":