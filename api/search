-57","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#operation-map","content":"No"},"1164":{"id":"/en/docs/runtime/host-runtime-api-58","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#operation-map","content":"Loader may populate transport caches"},"1165":{"id":"/en/docs/runtime/host-runtime-api-59","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#operation-map","content":"`preload()`"},"1166":{"id":"/en/docs/runtime/host-runtime-api-60","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#operation-map","content":"Warm the selected deployment before a likely mount."},"1167":{"id":"/en/docs/runtime/host-runtime-api-61","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#operation-map","content":"No"},"1168":{"id":"/en/docs/runtime/host-runtime-api-62","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#operation-map","content":"Uses loader preload or falls back to load"},"1169":{"id":"/en/docs/runtime/host-runtime-api-63","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#operation-map","content":"`mount()`"},"1170":{"id":"/en/docs/runtime/host-runtime-api-64","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#operation-map","content":"Run the complete application transaction and wait for readiness."},"1171":{"id":"/en/docs/runtime/host-runtime-api-65","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#operation-map","content":"Yes"},"1172":{"id":"/en/docs/runtime/host-runtime-api-66","page_id":"/en/docs/runtime/host-runtime-api","t