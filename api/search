/runtime/host-runtime-api#operation-map","content":"`inspect()`"},"1182":{"id":"/en/docs/runtime/host-runtime-api-76","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#operation-map","content":"Read live or cleanup-retained application transaction snapshots."},"1183":{"id":"/en/docs/runtime/host-runtime-api-77","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#operation-map","content":"No"},"1184":{"id":"/en/docs/runtime/host-runtime-api-78","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#operation-map","content":"Prunes clean terminal records"},"1185":{"id":"/en/docs/runtime/host-runtime-api-79","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#operation-map","content":"`audit()`"},"1186":{"id":"/en/docs/runtime/host-runtime-api-80","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#operation-map","content":"Check active instances, pending work, cleanup failures, and retained DOM."},"1187":{"id":"/en/docs/runtime/host-runtime-api-81","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#operation-map","content":"No"},"1188":{"id":"/en/docs/runtime/host-runtime-api-82","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#operation-map","content":"Synchronous report"},"1189":{"id":"/en/docs/runtime/host-runtime-api-83","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#operation-map","content":"`assertIdle()`"},"1190":{"id":"/en/docs/runtime/host-runtime-api-84","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#operation-map","content":"Turn a non-idle audit into a stable runtime-leak error."},"1191":{"id":"/en/docs/runtime/host-runtime-api-85","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#operation-map","content":"No"},"1192":{"id":"/en/docs/runtime/host-runtime-api-86","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#operation-map","content":"None"},"1193":{"id":"/en/docs/runtime/host-runtime-api-87","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#operation-map","content":"`subscribe()`"},"1194":{"id":"/en/docs/runtime/host-runtime-api-88","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#operation-map","content":"Observe state and error events without joining the transaction."},"1195":{"id":"/en/docs/runtime/host-runtime-api-89","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#operation-map","content":"No"},"1196":{"id":"/en/docs/runtime/host-runtime-api-90","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#operation-map","content":"Returns an unsubscribe function"},"1197":{"id":"/en/docs/runtime/host-runtime-api-91","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#operation-map","content":"`unmount()`"},"1198":{"id":"/en/docs/runtime/host-runtime-api-92","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#operation-map","content":"Unmount a live instance by ID."},"1199":{"id":"/en/docs/runtime/host-runtime-api-93","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#operation-map","content":"No"},"1200":{"id":"/en/docs/runtime/host-runtime-api-94","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#operation-map","content":"Delegates to that instance's cleanup"},"1201":{"id":"/en/docs/runtime/host-runtime-api-95","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#operation-map","content":"`dispose()`"},"1202":{"id":"/en/docs/runtime/host-runtime-api-96","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#operation-map","content":"Stop the Host, abort work, unmount everything, and prove cleanup."},"1203":{"id":"/en/docs/runtime/host-runtime-api-97","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#operation-map","content":"No"},"1204":{"id":"/en/docs/runtime/host-runtime-api-98","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#operation-map","content":"Terminal and idempotent"},"1205":{"id":"/en/docs/runtime/host-runtime-api-99","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#operation-map","content":"Direct `resolve`, `load`, and `preload` operations still count as pending Host work. `dispose()`\naborts them, and `audit().pendingOperations` includes them even though they have no application\nidentity."},"1206":{"id":"/en/docs/runtime/host-runtime-api-100","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#resolve","content":"Use `resolve()` when a caller needs the selected deployment metadata without fetching application\ncode—for example, to display a rollout decision or inspect an immutable artifact URL."},"1207":{"id":"/en/docs/runtime/host-runtime-api-101","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#resolve","content":"Policy fields are untrusted selection inputs. The registry or resolver remains responsible for\nauthorization; a browser query parameter MUST NOT be treated as proof of tenant or cohort\nmembership."},"1208":{"id":"/en/docs/runtime/host-runtime-api-102","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#load","content":"`load()` resolves the same reference, invokes the selected loader, and validates the exported\napplication protocol. It returns `{ app, resolved }` but does not create a container, service scope,\nor mounted identity. Use it for producer contract checks or tooling that genuinely needs the loaded\napplication object. Normal product navigation should call `mount()` directly."},"1209":{"id":"/en/docs/runtime/host-runtime-api-103","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#preload","content":"`preload()` is an optimization, never readiness evidence. If the loader implements `preload`, the\nHost delegates to it; otherwise the Host performs a normal load. The later mount MUST resolve policy\nagain, because a channel, tenant assignment, or registry decision may have changed."},"1210":{"id":"/en/docs/runtime/host-runtime-api-104","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#preload","content":"Correlate the two operations with a trace rather than reusing one operation ID:"},"1211":{"id":"/en/docs/runtime/host-runtime-api-105","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#the-mount-transaction","content":"`mount()` resolves only after the application's optional readiness promise has settled successfully.\nThe returned `MountedApplication.ready` is therefore already settled and is retained as a uniform\nconsumer surface."},"1212":{"id":"/en/docs/runtime/host-runtime-api-106","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#the-mount-transaction","content":"This sequence shows the acquisition order. If any phase fails or is aborted, the Host rolls back\nacquired resources in lifecycle order and retains audit evidence when cleanup cannot be proven."},"1213":{"id":"/en/docs/runtime/host-runtime-api-107","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#the-mount-transaction","content":"Important rules:"},"1214":{"id":"/en/docs/runtime/host-runtime-api-108","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#the-mount-transaction","content":"`instanceId`, `operationId`, and `traceId` are validated and snapshotted before asynchronous work."},"1215":{"id":"/en/docs/runtime/host-runtime-api-109","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#the-mount-transaction","content":"Identity is Host-issued. An app, loader, or browser input MUST NOT supply identity for authorization."},"1216":{"id":"/en/docs/runtime/host-runtime-api-110","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#the-mount-transaction","content":"Props and the target retain caller ownership; Host-owned envelopes such as references, policy,\nresolution metadata, and container requests are snapshotted."},"1217":{"id":"/en/docs/runtime/host-runtime-api-111","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#the-mount-transaction","content":"A container resolver runs after deployment resolution and before loader selection."},"1218":{"id":"/en/docs/runtime/host-runtime-api-112","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#the-mount-transaction","content":"`containerLoaders` may select a transport-specific loader by the planned container type, as the\niframe integration does."},"1219":{"id":"/en/docs/runtime/host-runtime-api-113","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#the-mount-transaction","content":"Declared capabilities are provisioned and authorized before the application receives services."},"1220":{"id":"/en/docs/runtime/host-runtime-api-114","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#the-mount-transaction","content":"Cancellation can arrive in any phase and always enters the same rollback path."},"1221":{"id":"/en/docs/runtime/host-runtime-api-115","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#the-mount-transaction","content":"Readiness timeout is a failure, not a successful hidden mount."},"1222":{"id":"/en/docs/runtime/host-runtime-api-116","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#resolution-aware-container-planning","content":"Pass a resolver instead of a static request when deployment metadata determines the execution\nboundary:"},"1223":{"id":"/en/docs/runtime/host-runtime-api-117","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#resolution-aware-container-planning","content":"The resolver receives the trusted identity, operation context, frozen resolution policy, resolved\ndeployment, signal, and Host target. It SHOULD make a deterministic request from those inputs and\nMUST NOT mount code itself."},"1224":{"id":"/en/docs/runtime/host-runtime-api-118","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#contextual-services","content":"Use static `services` for stateless shared implementations. Use `createServices` when a capability\nmust bind an instance identity, tenant, trace, or disposable resource:"},"1225":{"id":"/en/docs/runtime/host-runtime-api-119","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#contextual-services","content":"Provider services override same-named static services for that instance. The application sees only\nits declared and authorized own keys through revocable facades. Abort or unmount revokes access\nbefore provider disposal. Providers MUST honor `signal` and roll back partial allocation when they\nthrow before returning."},"1226":{"id":"/en/docs/runtime/host-runtime-api-120","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#mounted-application-controls","content":"Instance lifecycle calls are serialized. `activate()` and `deactivate()` are valid even when the\nproducer omits those optional callbacks; `update()` fails with a lifecycle error when the producer\ndoes not implement updates. `abort(reason)` aborts the instance signal and unmounts it."},"1227":{"id":"/en/docs/runtime/host-runtime-api-121","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#mounted-application-controls","content":"Call `application.unmount()` when holding the handle. Use `host.unmount(instanceId)` when an owner\ntracks IDs centrally. Successful unmount performs application cleanup, revokes and disposes the\nservice scope, disposes the container, and removes the live instance from `get()`."},"1228":{"id":"/en/docs/runtime/host-runtime-api-122","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#readiness-gated-replacement","content":"`replace(currentInstanceId, options)` stages the new application in a hidden, inert deployment slot.\nThe current instance remains available until the replacement resolves, loads, mounts, and becomes\nready."},"1229":{"id":"/en/docs/runtime/host-runtime-api-123","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#readiness-gated-replacement","content":"Replacement invariants:"},"1230":{"id":"/en/docs/runtime/host-runtime-api-124","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#readiness-gated-replacement","content":"A staging failure MUST leave the current instance mounted."},"1231":{"id":"/en/docs/runtime/host-runtime-api-125","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#readiness-gated-replacement","content":"Commit occurs only after readiness and only when the prepared container remains inside its staging\nslot."},"1232":{"id":"/en/docs/runtime/host-runtime-api-126","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#readiness-gated-replacement","content":"After commit, failure to clean up the previous instance does not roll back the ready replacement;\nit is returned as `previousCleanupError` and remains visible in audit data."},"1233":{"id":"/en/docs/runtime/host-runtime-api-127","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#readiness-gated-replacement","content":"Only one replacement may target a given current instance at a time."},"1234":{"id":"/en/docs/runtime/host-runtime-api-128","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#readiness-gated-replacement","content":"Business validation after readiness is product policy; reverse the registry decision and replace\nagain rather than mutating a loaded MF deployment in place."},"1235":{"id":"/en/docs/runtime/host-runtime-api-129","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#observability-and-inspection","content":"Use `subscribe()` for non-blocking lifecycle telemetry. A listener MUST NOT throw or perform slow\nwork inside the Host call stack."},"1236":{"id":"/en/docs/runtime/host-runtime-api-130","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#observability-and-inspection","content":"`inspect()` returns application transaction snapshots. `audit()` is the stronger resource view: it\nincludes live instances, cleanup failures, pending direct operations, replacement transactions, and\nowned containers retained after a terminal state."},"1237":{"id":"/en/docs/runtime/host-runtime-api-131","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#observability-and-inspection","content":"Do not use instance or trace IDs as high-cardinality metric labels. Keep them in traces and logs;\naggregate metrics by application, resolved version, container type, phase, and error code."},"1238":{"id":"/en/docs/runtime/host-runtime-api-132","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#cancellation-and-errors","content":"Every asynchronous extension receives an `AbortSignal`. Custom resolvers, loaders, container\nadapters, service providers, and applications MUST stop acquiring work when it aborts and MUST clean\nup anything already acquired."},"1239":{"id":"/en/docs/runtime/host-runtime-api-133","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#cancellation-and-errors","content":"Catch `FrontsError` by `code` and `phase`; do not parse messages. The stable error vocabulary is\ndefined in `errors.ts`. Preserve `cause` for diagnostics and redact\ntenant-sensitive resolution metadata and service arguments from telemetry."},"1240":{"id":"/en/docs/runtime/host-runtime-api-134","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#shutdown","content":"The composition root SHOULD call `dispose()` during shell shutdown and after each integration test.\nThe first call makes the Host terminal; later calls return the same disposal promise. Disposal:"},"1241":{"id":"/en/docs/runtime/host-runtime-api-135","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#shutdown","content":"rejects new Host work;"},"1242":{"id":"/en/docs/runtime/host-runtime-api-136","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#shutdown","content":"aborts application and direct-operation signals;"},"1243":{"id":"/en/docs/runtime/host-runtime-api-137","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#shutdown","content":"waits for pending mounts and replacements;"},"1244":{"id":"/en/docs/runtime/host-runtime-api-138","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#shutdown","content":"unmounts every live instance;"},"1245":{"id":"/en/docs/runtime/host-runtime-api-139","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#shutdown","content":"clears listeners;"},"1246":{"id":"/en/docs/runtime/host-runtime-api-140","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#shutdown","content":"rejects if audit still proves a leak or cleanup failure."},"1247":{"id":"/en/docs/runtime/host-runtime-api-141","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#shutdown","content":"After Host disposal, separately dispose any MF instance plugin resources, registry clients, or other\ntransport objects owned by the composition root."},"1248":{"id":"/en/docs/runtime/host-runtime-api-142","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#verification","content":"`pnpm exec vitest run packages/core/test/host.test.ts packages/core/test/replacement.test.ts`\nverifies operation behavior, lifecycle ordering, cancellation, replacement, and cleanup."},"1249":{"id":"/en/docs/runtime/host-runtime-api-143","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#verification","content":"`pnpm exec vitest run packages/core/test/observability.test.ts packages/core/test/services.test.ts`\nverifies events, audit, contextual service scopes, revocation, and provider disposal."},"1250":{"id":"/en/docs/runtime/host-runtime-api-144","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#verification","content":"`packages/core/src/host/types.ts` is the signature source of\ntruth for the Host and mounted-instance APIs."},"1251":{"id":"/en/docs/runtime/host-runtime-api-145","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#verification","content":"`e2e/core-only.spec.ts` verifies the full Host lifecycle without MF."},"1252":{"id":"/en/docs/runtime/host-runtime-api-146","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#verification","content":"`e2e/vertical-slice.spec.ts` verifies the same Host contract across\nReact, Vue, DOM, Shadow DOM, and iframe execution."},"1253":{"id":"/en/docs/runtime/host-runtime-api-147","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#related-documentation","content":"Application contract"},"1254":{"id":"/en/docs/runtime/host-runtime-api-148","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#related-documentation","content":"Architecture"},"1255":{"id":"/en/docs/runtime/host-runtime-api-149","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#related-documentation","content":"Resolution and delivery"},"1256":{"id":"/en/docs/runtime/host-runtime-api-150","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#related-documentation","content":"Isolation and security"},"1257":{"id":"/en/docs/runtime/host-runtime-api-151","page_id":"/en/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/en/docs/runtime/host-runtime-api#related-documentation","content":"Operations"},"1258":{"id":"/en/docs/runtime/iframe-deployment","page_id":"/en/docs/runtime/iframe-deployment","type":"page","content":"Iframe Deployment","breadcrumbs":["Fronts 2.0 Documentation","Runtime guides","Runtime guides"],"tags":[],"url":"/en/docs/runtime/iframe-deployment"},"1259":{"id":"/en/docs/runtime/iframe-deployment-0","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment","content":"Production wiring, trust boundaries, capability negotiation, lifecycle, and verification for isolated Fronts applications."},"1260":{"id":"/en/docs/runtime/iframe-deployment-1","page_id":"/en/docs/runtime/iframe-deployment","type":"heading","tags":[],"url":"/en/docs/runtime/iframe-deployment#purpose","content":"Purpose"},"1261":{"id":"/en/docs/runtime/iframe-deployment-2","page_id":"/en/docs/runtime/iframe-deployment","type":"heading","tags":[],"url":"/en/docs/runtime/iframe-deployment#deployment-topology","content":"Deployment topology"},"1262":{"id":"/en/docs/runtime/iframe-deployment-3","page_id":"/en/docs/runtime/iframe-deployment","type":"heading","tags":[],"url":"/en/docs/runtime/iframe-deployment#parent-host-wiring","content":"Parent Host wiring"},"1263":{"id":"/en/docs/runtime/iframe-deployment-4","page_id":"/en/docs/runtime/iframe-deployment","type":"heading","tags":[],"url":"/en/docs/runtime/iframe-deployment#resolution-aware-frame-request","content":"Resolution-aware frame request"},"1264":{"id":"/en/docs/runtime/iframe-deployment-5","page_id":"/en/docs/runtime/iframe-deployment","type":"heading","tags":[],"url":"/en/docs/runtime/iframe-deployment#child-agent-wiring","content":"Child agent wiring"},"1265":{"id":"/en/docs/runtime/iframe-deployment-6","page_id":"/en/docs/runtime/iframe-deployment","type":"heading","tags":[],"url":"/en/docs/runtime/iframe-deployment#handshake-and-readiness","content":"Handshake and readiness"},"1266":{"id":"/en/docs/runtime/iframe-deployment-7","page_id":"/en/docs/runtime/iframe-deployment","type":"heading","tags":[],"url":"/en/docs/runtime/iframe-deployment#capability-negotiation","content":"Capability negotiation"},"1267":{"id":"/en/docs/runtime/iframe-deployment-8","page_id":"/en/docs/runtime/iframe-deployment","type":"heading","tags":[],"url":"/en/docs/runtime/iframe-deployment#origin-and-sandbox-contract","content":"Origin and sandbox contract"},"1268":{"id":"/en/docs/runtime/iframe-deployment-9","page_id":"/en/docs/runtime/iframe-deployment","type":"heading","tags":[],"url":"/en/docs/runtime/iframe-deployment#browser-and-server-policy","content":"Browser and server policy"},"1269":{"id":"/en/docs/runtime/iframe-deployment-10","page_id":"/en/docs/runtime/iframe-deployment","type":"heading","tags":[],"url":"/en/docs/runtime/iframe-deployment#timeouts-and-cancellation","content":"Timeouts and cancellation"},"1270":{"id":"/en/docs/runtime/iframe-deployment-11","page_id":"/en/docs/runtime/iframe-deployment","type":"heading","tags":[],"url":"/en/docs/runtime/iframe-deployment#lifecycle-and-shutdown","content":"Lifecycle and shutdown"},"1271":{"id":"/en/docs/runtime/iframe-deployment-12","page_id":"/en/docs/runtime/iframe-deployment","type":"heading","tags":[],"url":"/en/docs/runtime/iframe-deployment#production-checklist","content":"Production checklist"},"1272":{"id":"/en/docs/runtime/iframe-deployment-13","page_id":"/en/docs/runtime/iframe-deployment","type":"heading","tags":[],"url":"/en/docs/runtime/iframe-deployment#non-goals","content":"Non-goals"},"1273":{"id":"/en/docs/runtime/iframe-deployment-14","page_id":"/en/docs/runtime/iframe-deployment","type":"heading","tags":[],"url":"/en/docs/runtime/iframe-deployment#verification","content":"Verification"},"1274":{"id":"/en/docs/runtime/iframe-deployment-15","page_id":"/en/docs/runtime/iframe-deployment","type":"heading","tags":[],"url":"/en/docs/runtime/iframe-deployment#related-documentation","content":"Related documentation"},"1275":{"id":"/en/docs/runtime/iframe-deployment-16","page_id":"/en/docs/runtime/iframe-deployment","type":"heading","tags":[],"url":"/en/docs/runtime/iframe-deployment#citations","content":"Citations"},"1276":{"id":"/en/docs/runtime/iframe-deployment-17","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#purpose","content":"The iframe integration runs a Fronts application in a different browser realm and origin while\npreserving the same Host lifecycle. It is appropriate when an application needs stronger DOM and\nglobal isolation, has incompatible dependencies, or must receive only an explicit RPC capability\nsurface."},"1277":{"id":"/en/docs/runtime/iframe-deployment-18","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#purpose","content":"It is not a way to evaluate a remote in the parent realm and then move rendered DOM into an iframe.\nThe child document owns a separate application loader—and, when MF is used, a separate official MF\nruntime instance. Public types in `@fronts/core/iframe` are the\nsignature source of truth."},"1278":{"id":"/en/docs/runtime/iframe-deployment-19","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#deployment-topology","content":"This shows the security boundary. The shell never evaluates the isolated application. The agent\norigin may load the application from a third artifact origin, provided that the artifact server and\nthe child document's browser policy allow it."},"1279":{"id":"/en/docs/runtime/iframe-deployment-20","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#deployment-topology","content":"A production deployment normally has:"},"1280":{"id":"/en/docs/runtime/iframe-deployment-21","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#deployment-topology","content":"a shell origin, for example `https://app.example.com`;"},"1281":{"id":"/en/docs/runtime/iframe-deployment-22","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#deployment-topology","content":"a dedicated agent origin, for example `https://fronts-frame.example.net`;"},"1282":{"id":"/en/docs/runtime/iframe-deployment-23","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#deployment-topology","content":"one or more immutable application artifact origins or paths."},"1283":{"id":"/en/docs/runtime/iframe-deployment-24","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#deployment-topology","content":"The agent origin MUST differ from the shell origin. It SHOULD contain only the minimal agent shell,\nloader, and policies required to run isolated applications."},"1284":{"id":"/en/docs/runtime/iframe-deployment-25","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#parent-host-wiring","content":"Three pieces must be registered together:"},"1285":{"id":"/en/docs/runtime/iframe-deployment-26","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#parent-host-wiring","content":"`createIframeContainer()` creates and owns the `<iframe>` element;"},"1286":{"id":"/en/docs/runtime/iframe-deployment-27","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#parent-host-wiring","content":"`createIframeProxyLoader()` presents remote iframe lifecycle as a `FrontsApp` in the parent;"},"1287":{"id":"/en/docs/runtime/iframe-deployment-28","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#parent-host-wiring","content":"`containerLoaders.iframe` selects that proxy instead of evaluating the resolved source in the\nparent realm."},"1288":{"id":"/en/docs/runtime/iframe-deployment-29","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#parent-host-wiring","content":"The normal `loader` remains available for non-iframe containers. The `iframe` loader override is\nwhat prevents the parent from loading the isolated source."},"1289":{"id":"/en/docs/runtime/iframe-deployment-30","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#resolution-aware-frame-request","content":"Generate the iframe request after deployment resolution so a registry can select an origin by\nenvironment, tenant, release channel, or cohort:"},"1290":{"id":"/en/docs/runtime/iframe-deployment-31","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#resolution-aware-frame-request","content":"Registry metadata MUST be validated before it becomes a container request. `targetOrigin` is a\ncanonical origin only—scheme, host, and optional port, with no path—and `src` must resolve to that\nsame origin. Wildcard target origins are rejected."},"1291":{"id":"/en/docs/runtime/iframe-deployment-32","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#child-agent-wiring","content":"The child document creates its own loader and starts one iframe agent:"},"1292":{"id":"/en/docs/runtime/iframe-deployment-33","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#child-agent-wiring","content":"`allowedOrigins` MUST contain one or more exact canonical parent origins and MUST NOT contain `*`.\nThe agent also checks that the message source is its expected parent window, validates the protocol\nshape and version, and accepts exactly one transferred `MessagePort` per connection."},"1293":{"id":"/en/docs/runtime/iframe-deployment-34","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#child-agent-wiring","content":"The child loader receives the parent-resolved deployment and trusted identity in an\napplication-scoped operation context. It loads and validates the real `FrontsApp`, mounts it into an\nagent-owned root, waits for application readiness, and then notifies the parent."},"1294":{"id":"/en/docs/runtime/iframe-deployment-35","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#handshake-and-readiness","content":"This sequence is one Host mount transaction. Parent readiness does not complete until the child\napplication has loaded, negotiated capabilities, mounted, and reported ready. A fatal child error,\ntimeout, or cancellation rejects the parent mount and triggers cleanup on both sides."},"1295":{"id":"/en/docs/runtime/iframe-deployment-36","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#handshake-and-readiness","content":"The connection envelope carries resolved source data, metadata, identity, and props through the\nstructured clone algorithm. Those values MUST be structured-cloneable; functions, DOM nodes,\nproxies, and other realm-bound objects cannot be used as iframe source metadata or props."},"1296":{"id":"/en/docs/runtime/iframe-deployment-37","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#capability-negotiation","content":"The final service grant is the intersection of:"},"1297":{"id":"/en/docs/runtime/iframe-deployment-38","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#capability-negotiation","content":"the maximum configured on `createIframeProxyLoader` for that resolved deployment;"},"1298":{"id":"/en/docs/runtime/iframe-deployment-39","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#capability-negotiation","content":"capabilities actually available from the parent instance service scope after provisioning and\n`capabilityPolicy`;"},"1299":{"id":"/en/docs/runtime/iframe-deployment-40","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#capability-negotiation","content":"capabilities declared by the real application loaded in the child."},"1300":{"id":"/en/docs/runtime/iframe-deployment-41","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#capability-negotiation","content":"The proxy maximum is not treated as the child's declaration. The child must request its complete\ndeclared set exactly once; missing or additional capabilities fail closed. The parent validates the\nlocked grant again on every `service.call`."},"1301":{"id":"/en/docs/runtime/iframe-deployment-42","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#capability-negotiation","content":"Services are method-only RPC facades. The child never receives the original parent object. RPC\narguments and results MUST be structured-cloneable, and privileged services MUST validate every\nargument in the parent implementation. Bind tenant, identity, authorization, and audit data in the\nparent's `createServices` closure rather than accepting those claims from child arguments."},"1302":{"id":"/en/docs/runtime/iframe-deployment-43","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#capability-negotiation","content":"Do not expose ambient authority such as:"},"1303":{"id":"/en/docs/runtime/iframe-deployment-44","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#capability-negotiation","content":"raw access tokens or cookie values;"},"1304":{"id":"/en/docs/runtime/iframe-deployment-45","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#capability-negotiation","content":"unrestricted `fetch`, storage, DOM, or browser globals;"},"1305":{"id":"/en/docs/runtime/iframe-deployment-46","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#capability-negotiation","content":"generic `eval`, script execution, or arbitrary method dispatch;"},"1306":{"id":"/en/docs/runtime/iframe-deployment-47","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#capability-negotiation","content":"navigation without destination validation;"},"1307":{"id":"/en/docs/runtime/iframe-deployment-48","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#capability-negotiation","content":"telemetry that accepts unbounded or sensitive payloads."},"1308":{"id":"/en/docs/runtime/iframe-deployment-49","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#capability-negotiation","content":"Rate-limit expensive calls and record denied capability requests and privileged invocations with\nthe parent-issued identity."},"1309":{"id":"/en/docs/runtime/iframe-deployment-50","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#origin-and-sandbox-contract","content":"The built-in transport intentionally requires both `allow-scripts` and `allow-same-origin`:"},"1310":{"id":"/en/docs/runtime/iframe-deployment-51","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#origin-and-sandbox-contract","content":"scripts are required to run the child agent;"},"1311":{"id":"/en/docs/runtime/iframe-deployment-52","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#origin-and-sandbox-contract","content":"preserving the dedicated child origin is required for an exact `targetOrigin` handshake;"},"1312":{"id":"/en/docs/runtime/iframe-deployment-53","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#origin-and-sandbox-contract","content":"the container rejects an agent `src` whose origin equals the parent document origin."},"1313":{"id":"/en/docs/runtime/iframe-deployment-54","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#origin-and-sandbox-contract","content":"On a dedicated cross-origin deployment, `allow-same-origin` preserves the child's own origin; it\ndoes not make it same-origin with the shell. Never serve this agent from the shell origin: combining\nsame-origin content, scripts, and `allow-same-origin` weakens the intended sandbox boundary."},"1314":{"id":"/en/docs/runtime/iframe-deployment-55","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#origin-and-sandbox-contract","content":"The default sandbox is the required pair. Add tokens and browser permissions only after reviewing\nthe application need. Generic `attributes` cannot override `src`, `srcdoc`, `sandbox`, `allow`,\nloading/name/referrer/title fields, Fronts `data-*` state, or inline event handlers."},"1315":{"id":"/en/docs/runtime/iframe-deployment-56","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#origin-and-sandbox-contract","content":"`targetOrigin=\"*\"` is never allowed. The child checks both `event.origin` and `event.source`, and all\nsubsequent traffic moves onto the transferred, random-channel-bound `MessagePort`.\nCreating that channel requires `globalThis.crypto.randomUUID()`; production shells MUST run in a\nbrowser context where it is available, normally a secure HTTPS context."},"1316":{"id":"/en/docs/runtime/iframe-deployment-57","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#browser-and-server-policy","content":"Fronts validates the runtime handshake, not the surrounding HTTP deployment. Configure at least:"},"1317":{"id":"/en/docs/runtime/iframe-deployment-58","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#browser-and-server-policy","content":"shell CSP `frame-src` for the exact agent origin;"},"1318":{"id":"/en/docs/runtime/iframe-deployment-59","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#browser-and-server-policy","content":"child CSP `script-src` and `connect-src` for its loader, manifest, remote entry, chunks, APIs, and\ntelemetry endpoints;"},"1319":{"id":"/en/docs/runtime/iframe-deployment-60","page_id":"/en/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/en/docs/runtime/iframe-deployment#browser-and-server-policy","content":"CORS headers on module/manifest/chunk origins needed by the child loader;"},"1320":{"id":"/en/docs/runtime/iframe-deployment-61","page_id":"/en/docs/runtime/iframe-d