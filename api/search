e_id":"/zh/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/zh/docs/runtime/host-runtime-api#操作地图","content":"services、container、app handle"},"500":{"id":"/zh/docs/runtime/host-runtime-api-32","page_id":"/zh/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/zh/docs/runtime/host-runtime-api#操作地图","content":"`replace()`"},"501":{"id":"/zh/docs/runtime/host-runtime-api-33","page_id":"/zh/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/zh/docs/runtime/host-runtime-api#操作地图","content":"保持当前实例可用并 staging 候选"},"502":{"id":"/zh/docs/runtime/host-runtime-api-34","page_id":"/zh/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/zh/docs/runtime/host-runtime-api#操作地图","content":"是"},"503":{"id":"/zh/docs/runtime/host-runtime-api-35","page_id":"/zh/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/zh/docs/runtime/host-runtime-api#操作地图","content":"提交新实例后清理旧实例"},"504":{"id":"/zh/docs/runtime/host-runtime-api-36","page_id":"/zh/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/zh/docs/runtime/host-runtime-api#操作地图","content":"`get()`/`inspect()`"},"505":{"id":"/zh/docs/runtime/host-runtime-api-37","page_id":"/zh/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/zh/docs/runtime/host-runtime-api#操作地图","content":"读取 live handle 或事务 snapshot"},"506":{"id":"/zh/docs/runtime/host-runtime-api-38","page_id":"/zh/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/zh/docs/runtime/host-runtime-api#操作地图","content":"否"},"507":{"id":"/zh/docs/runtime/host-runtime-api-39","page_id":"/zh/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/zh/docs/runtime/host-runtime-api#操作地图","content":"inspect 会裁剪干净 terminal record"},"508":{"id":"/zh/docs/runtime/host-runtime-api-40","page_id":"/zh/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/zh/docs/runtime/host-runtime-api#操作地图","content":"`audit()`/`assertIdle()`"},"509":{"id":"/zh/docs/runtime/host-runtime-api-41","page_id":"/zh/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/zh/docs/runtime/host-runtime-api#操作地图","content":"检查实例、pending、cleanup failure 和 retained DOM"},"510":{"id":"/zh/docs/runtime/host-runtime-api-42","page_id":"/zh/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/zh/docs/runtime/host-runtime-api#操作地图","content":"否"},"511":{"id":"/zh/docs/runtime/host-runtime-api-43","page_id":"/zh/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/zh/docs/runtime/host-runtime-api#操作地图","content":"assert 转成稳定 leak error"},"512":{"id":"/zh/docs/runtime/host-runtime-api-44","page_id":"/zh/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/zh/docs/runtime/host-runtime-api#操作地图","content":"`subscribe()`"},"513":{"id":"/zh/docs/runtime/host-runtime-api-45","page_id":"/zh/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/zh/docs/runtime/host-runtime-api#操作地图","content":"非阻塞观测 state/error event"},"514":{"id":"/zh/docs/runtime/host-runtime-api-46","page_id":"/zh/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/zh/docs/runtime/host-runtime-api#操作地图","content":"否"},"515":{"id":"/zh/docs/runtime/host-runtime-api-47","page_id":"/zh/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/zh/docs/runtime/host-runtime-api#操作地图","content":"返回 unsubscribe"},"516":{"id":"/zh/docs/runtime/host-runtime-api-48","page_id":"/zh/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/zh/docs/runtime/host-runtime-api#操作地图","content":"`unmount()`"},"517":{"id":"/zh/docs/runtime/host-runtime-api-49","page_id":"/zh/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/zh/docs/runtime/host-runtime-api#操作地图","content":"按 ID 卸载 live instance"},"518":{"id":"/zh/docs/runtime/host-runtime-api-50","page_id":"/zh/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/zh/docs/runtime/host-runtime-api#操作地图","content":"否"},"519":{"id":"/zh/docs/runtime/host-runtime-api-51","page_id":"/zh/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/zh/docs/runtime/host-runtime-api#操作地图","content":"执行该实例完整清理"},"520":{"id":"/zh/docs/runtime/host-runtime-api-52","page_id":"/zh/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/zh/docs/runtime/host-runtime-api#操作地图","content":"`dispose()`"},"521":{"id":"/zh/docs/runtime/host-runtime-api-53","page_id":"/zh/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/zh/docs/runtime/host-runtime-api#操作地图","content":"停止 Host、abort、卸载并证明清理"},"522":{"id":"/zh/docs/runtime/host-runtime-api-54","page_id":"/zh/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/zh/docs/runtime/host-runtime-api#操作地图","content":"否"},"523":{"id":"/zh/docs/runtime/host-runtime-api-55","page_id":"/zh/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/zh/docs/runtime/host-runtime-api#操作地图","content":"terminal 且幂等"},"524":{"id":"/zh/docs/runtime/host-runtime-api-56","page_id":"/zh/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/zh/docs/runtime/host-runtime-api#操作地图","content":"直接 resolve/load/preload 也计入 pending Host work；它们没有 application identity，但会出现在\n`audit().pendingOperations`，并被 `dispose()` abort。"},"525":{"id":"/zh/docs/runtime/host-runtime-api-57","page_id":"/zh/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/zh/docs/runtime/host-runtime-api#解析加载和预加载","content":"`resolve()` 适合在不取代码时显示 rollout 决策或不可变 artifact URL。environment、tenant、cohort\n等字段是不可信的选择输入，不是授权凭证；registry 必须自行认证和授权。`load()` 返回\n`{ app, resolved }`，但不创建 target、service scope 或 mounted identity，主要用于 producer\ncontract 工具，普通导航应直接 mount。"},"526":{"id":"/zh/docs/runtime/host-runtime-api-58","page_id":"/zh/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/zh/docs/runtime/host-runtime-api#解析加载和预加载","content":"`preload()` 只是优化，绝不是 readiness 证据。loader 没有 preload 时 Host 会普通 load；之后的\nmount 必须重新解析，因为 channel、tenant assignment 或 registry decision 可能变化。可用相同\ntrace 关联 preload 和 mount，但不能重用 operation ID。"},"527":{"id":"/zh/docs/runtime/host-runtime-api-59","page_id":"/zh/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/zh/docs/runtime/host-runtime-api#挂载事务","content":"Host 在异步工作前校验并快照 instance/operation/trace ID。identity 只能由 Host 颁发，应用、loader\n或浏览器输入不得提供授权身份。caller 仍拥有 props 与外部 target；reference、policy、resolution\nmetadata 和 container request 等 Host envelope 会被快照。任一阶段失败或 abort 都走同一条回滚，\nreadiness timeout 是失败，不能作为隐藏成功。"},"528":{"id":"/zh/docs/runtime/host-runtime-api-60","page_id":"/zh/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/zh/docs/runtime/host-runtime-api#挂载事务","content":"部署 metadata 决定隔离方式时，可传 container resolver："},"529":{"id":"/zh/docs/runtime/host-runtime-api-61","page_id":"/zh/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/zh/docs/runtime/host-runtime-api#挂载事务","content":"它在 resolution 之后、loader 选择之前运行，收到可信 identity、operation、冻结的 policy/resolved、\nsignal 与 Host target；必须确定性地产生 request，不能自行 mount。"},"530":{"id":"/zh/docs/runtime/host-runtime-api-62","page_id":"/zh/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/zh/docs/runtime/host-runtime-api#上下文服务","content":"无状态共享实现使用静态 `services`；需要绑定实例、租户、trace 或 disposable resource 时使用\n`createServices`。provider service 覆盖同名静态 service，之后 Host 才按声明和 policy 生成仅含\nown keys 的可撤销 facade。abort/unmount 先 revoke，再 dispose provider；provider 必须响应 signal，\n并在返回前抛错时自行回滚尚未移交的资源。"},"531":{"id":"/zh/docs/runtime/host-runtime-api-63","page_id":"/zh/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/zh/docs/runtime/host-runtime-api#实例控制与就绪替换","content":"`activate()`、`update(nextProps)`、`deactivate()` 与 `unmount()` 在每个实例上串行。producer 没有\nactivate/deactivate callback 时它们仍有效；没有 update 时则返回 lifecycle error。`abort(reason)`\n触发 instance signal 并卸载。持有 handle 时调用 `application.unmount()`，集中跟踪 ID 时调用\n`host.unmount(id)`。"},"532":{"id":"/zh/docs/runtime/host-runtime-api-64","page_id":"/zh/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/zh/docs/runtime/host-runtime-api#实例控制与就绪替换","content":"`replace(id, options)` 在 hidden/inert staging slot 中挂载候选；候选 resolve/load/mount/ready\n全部成功前，当前实例保持可用。staging 失败必须保留旧实例；commit 后旧实例 cleanup 失败不回滚\n已 ready 的新实例，而是返回 `previousCleanupError` 并留在 audit；同一 current instance 只能有一个\nreplacement。业务验证失败应回退 registry 决策再 replace，不能直接修改活跃 MF deployment cache。"},"533":{"id":"/zh/docs/runtime/host-runtime-api-65","page_id":"/zh/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/zh/docs/runtime/host-runtime-api#观测错误和关闭","content":"`subscribe()` listener 不参与事务，不得在 Host call stack 中抛错或慢执行。`inspect()` 看事务状态，\n`audit()` 还包含 live instance、cleanup failure、direct operation、replacement 和 terminal state 后\n仍保留的容器。instance/trace ID 放日志与 trace，不要做高基数 metric label；metric 应按 app、version、\ncontainer type、phase、error code 聚合。"},"534":{"id":"/zh/docs/runtime/host-runtime-api-66","page_id":"/zh/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/zh/docs/runtime/host-runtime-api#观测错误和关闭","content":"捕获 `FrontsError` 时使用稳定的 `code` 和 `phase`，不要解析 message；保留 `cause` 但在 telemetry\n中移除 tenant-sensitive metadata 与 service 参数。composition root 在 shell shutdown 和每个集成测试\n后调用 `dispose()`：它拒绝新任务、abort signals、等待 pending mount/replace、卸载全部 live app、\n清除 listener，并在 audit 仍证明泄漏时 reject。最后用 `host.assertIdle()` 明确验证。"},"535":{"id":"/zh/docs/runtime/host-runtime-api-67","page_id":"/zh/docs/runtime/host-runtime-api","tags":[],"type":"text","url":"/zh/docs/runtime/host-runtime-api#验证","content":"core host/replacement/observability/services 测试覆盖顺序、取消、替换、审计与 provider disposal；\ncore-only E2E 验证无 MF 路径，vertical-slice E2E 验证 React、Vue、DOM、Shadow DOM 和 iframe 的同一契约。"},"536":{"id":"/zh/docs/runtime/iframe-deployment","page_id":"/zh/docs/runtime/iframe-deployment","type":"page","content":"Iframe 部署","breadcrumbs":["Fronts 2.0 文档","运行时指南","运行时指南"],"tags":[],"url":"/zh/docs/runtime/iframe-deployment"},"537":{"id":"/zh/docs/runtime/iframe-deployment-0","page_id":"/zh/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/zh/docs/runtime/iframe-deployment","content":"隔离 Fronts 应用的生产接线、信任边界、capability 协商、生命周期与验证。"},"538":{"id":"/zh/docs/runtime/iframe-deployment-1","page_id":"/zh/docs/runtime/iframe-deployment","type":"heading","tags":[],"url":"/zh/docs/runtime/iframe-deployment#目的与拓扑","content":"目的与拓扑"},"539":{"id":"/zh/docs/runtime/iframe-deployment-2","page_id":"/zh/docs/runtime/iframe-deployment","type":"heading","tags":[],"url":"/zh/docs/runtime/iframe-deployment#parent-host-接线","content":"Parent Host 接线"},"540":{"id":"/zh/docs/runtime/iframe-deployment-3","page_id":"/zh/docs/runtime/iframe-deployment","type":"heading","tags":[],"url":"/zh/docs/runtime/iframe-deployment#根据-resolution-生成-frame-request","content":"根据 resolution 生成 frame request"},"541":{"id":"/zh/docs/runtime/iframe-deployment-4","page_id":"/zh/docs/runtime/iframe-deployment","type":"heading","tags":[],"url":"/zh/docs/runtime/iframe-deployment#child-agent-接线","content":"Child agent 接线"},"542":{"id":"/zh/docs/runtime/iframe-deployment-5","page_id":"/zh/docs/runtime/iframe-deployment","type":"heading","tags":[],"url":"/zh/docs/runtime/iframe-deployment#握手与-readiness","content":"握手与 readiness"},"543":{"id":"/zh/docs/runtime/iframe-deployment-6","page_id":"/zh/docs/runtime/iframe-deployment","type":"heading","tags":[],"url":"/zh/docs/runtime/iframe-deployment#capability-协商","content":"Capability 协商"},"544":{"id":"/zh/docs/runtime/iframe-deployment-7","page_id":"/zh/docs/runtime/iframe-deployment","type":"heading","tags":[],"url":"/zh/docs/runtime/iframe-deployment#originsandbox-与-http-policy","content":"Origin、sandbox 与 HTTP policy"},"545":{"id":"/zh/docs/runtime/iframe-deployment-8","page_id":"/zh/docs/runtime/iframe-deployment","type":"heading","tags":[],"url":"/zh/docs/runtime/iframe-deployment#timeout取消和关闭","content":"Timeout、取消和关闭"},"546":{"id":"/zh/docs/runtime/iframe-deployment-9","page_id":"/zh/docs/runtime/iframe-deployment","type":"heading","tags":[],"url":"/zh/docs/runtime/iframe-deployment#上线清单与验证","content":"上线清单与验证"},"547":{"id":"/zh/docs/runtime/iframe-deployment-10","page_id":"/zh/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/zh/docs/runtime/iframe-deployment#目的与拓扑","content":"iframe 集成让 Fronts 应用在不同 browser realm 与 origin 中运行，同时保留相同 Host lifecycle。它适合\n需要更强 DOM/global 隔离、依赖不兼容，或只能获得显式 RPC capability surface 的应用。它不是在\nparent 执行 remote 后把 DOM 搬进 iframe；child document 拥有独立 loader，使用 MF 时也拥有独立\n官方 Runtime instance。"},"548":{"id":"/zh/docs/runtime/iframe-deployment-11","page_id":"/zh/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/zh/docs/runtime/iframe-deployment#目的与拓扑","content":"典型生产部署有 shell origin、与其不同的专用 agent origin，以及一个或多个不可变 artifact origin。\nagent origin 应只放运行隔离应用必需的最小 shell、loader 与 policy。shell 从不执行隔离应用；agent\n可从第三个 origin 加载产物，但 artifact server、CORS 和 child browser policy 必须允许。"},"549":{"id":"/zh/docs/runtime/iframe-deployment-12","page_id":"/zh/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/zh/docs/runtime/iframe-deployment#parent-host-接线","content":"三个部件必须一起注册：`createIframeContainer()` 创建并拥有 `<iframe>`；\n`createIframeProxyLoader()` 把远端 child lifecycle 表现为 parent 中的 `FrontsApp`；\n`containerLoaders.iframe` 选择 proxy，防止普通 loader 在 parent 执行 source。"},"550":{"id":"/zh/docs/runtime/iframe-deployment-13","page_id":"/zh/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/zh/docs/runtime/iframe-deployment#parent-host-接线","content":"普通 loader 继续用于非 iframe container；iframe override 才是“不在 parent 加载”的关键。"},"551":{"id":"/zh/docs/runtime/iframe-deployment-14","page_id":"/zh/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/zh/docs/runtime/iframe-deployment#根据-resolution-生成-frame-request","content":"registry 可以按 environment、tenant、channel 或 cohort 返回不同 agent："},"552":{"id":"/zh/docs/runtime/iframe-deployment-15","page_id":"/zh/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/zh/docs/runtime/iframe-deployment#根据-resolution-生成-frame-request","content":"在创建 request 前验证 registry metadata。`targetOrigin` 必须是只含 scheme、host、可选 port 的\ncanonical origin，不能带 path；`src` 必须解析到同一 origin；通配 origin 会被拒绝。"},"553":{"id":"/zh/docs/runtime/iframe-deployment-16","page_id":"/zh/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/zh/docs/runtime/iframe-deployment#child-agent-接线","content":"child 页面创建 target、自有 Runtime/loader，并启动一个 agent："},"554":{"id":"/zh/docs/runtime/iframe-deployment-17","page_id":"/zh/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/zh/docs/runtime/iframe-deployment#child-agent-接线","content":"`allowedOrigins` 至少包含一个 exact canonical parent origin，且不允许 `*`。agent 还校验 message\nsource 是预期 parent window、协议 shape/version，并且每个连接只接收一个 transferred MessagePort。\nchild loader 得到 parent 已解析部署和可信 identity，加载、验证真实 FrontsApp，挂载到 agent-owned\nroot，等待 ready 后才通知 parent。"},"555":{"id":"/zh/docs/runtime/iframe-deployment-18","page_id":"/zh/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/zh/docs/runtime/iframe-deployment#握手与-readiness","content":"这是同一个 Host mount transaction。child 未完成 load、协商、mount 和 ready 前，parent mount 不会\n完成。child fatal error、timeout 或取消会 reject parent mount，并让两端 cleanup。source、metadata、\nidentity、props 通过 structured clone 传递，不能包含 function、DOM node、proxy 或 realm-bound object。"},"556":{"id":"/zh/docs/runtime/iframe-deployment-19","page_id":"/zh/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/zh/docs/runtime/iframe-deployment#capability-协商","content":"最终 grant 是 proxy 最大集合、parent 实例 scope 经 provider/policy 后的可用能力、child 真实应用声明\n三者交集。child 必须且只能提交完整声明一次，缺少或多加都 fail closed；parent 每次 service call\n再次验证锁定 grant。服务是 method-only RPC facade，参数/结果必须 structured clone；敏感实现必须\n在 parent 校验参数，并在 `createServices` 闭包绑定 tenant、identity、auth 与 audit，而非相信 child 参数。"},"557":{"id":"/zh/docs/runtime/iframe-deployment-20","page_id":"/zh/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/zh/docs/runtime/iframe-deployment#capability-协商","content":"不要暴露 token/cookie、unrestricted fetch/storage/DOM、eval、任意 method dispatch、未校验 navigation\n或接收无限敏感 payload 的 telemetry。对昂贵调用限流，用 parent-issued identity 记录拒绝与特权调用。"},"558":{"id":"/zh/docs/runtime/iframe-deployment-21","page_id":"/zh/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/zh/docs/runtime/iframe-deployment#originsandbox-与-http-policy","content":"transport 强制 `allow-scripts` + `allow-same-origin`：前者运行 agent，后者保留专用 child origin 才能\n使用 exact targetOrigin。container 拒绝与 parent document 同源的 agent `src`。跨源部署中的\nallow-same-origin 只表示 child 保留自己的 origin，不让它与 shell 同源。其他 token 与 iframe `allow`\n权限需要逐项评审，generic attributes 不能覆盖专用 typed fields、Fronts data 或 inline handler。"},"559":{"id":"/zh/docs/runtime/iframe-deployment-22","page_id":"/zh/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/zh/docs/runtime/iframe-deployment#originsandbox-与-http-policy","content":"必须配置 shell CSP `frame-src`、child CSP `script-src`/`connect-src`、agent response `frame-ancestors`、\nchild loader 所需 CORS、HTTPS/immutable URL、跨站 cookie 的 SameSite/Secure/domain、权限策略，以及\n开启 cross-origin isolation 时兼容的 COOP/COEP/CORP。凭证与 bearer token 不得出现在 src、manifest\nURL、query 或 resolution metadata；API 服务端仍负责 authn/authz。channel 使用\n`crypto.randomUUID()`，生产 shell 应运行在能提供它的安全 HTTPS context。"},"560":{"id":"/zh/docs/runtime/iframe-deployment-23","page_id":"/zh/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/zh/docs/runtime/iframe-deployment#timeout取消和关闭","content":"Host `readyTimeoutMs` 覆盖整个挂载与就绪；parent `handshakeTimeoutMs` 覆盖 frame load/agent handshake；\nparent/child `requestTimeoutMs` 覆盖单次 lifecycle/service RPC。三者必须有限非负；`0` 只禁用对应\ndeadline，signal 仍有效。生产应保持有限，并让 Host readiness budget 容纳 child load 与应用 ready。"},"561":{"id":"/zh/docs/runtime/iframe-deployment-24","page_id":"/zh/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/zh/docs/runtime/iframe-deployment#timeout取消和关闭","content":"update/activate/deactivate 变成相关联 RPC。卸载时 parent 请求 child unmount；child abort session 并\n清理真实 handle、agent root 和 peer；parent 关闭 peer，Host revoke service scope；最后 container 删除\niframe。parent composition root 必须 `host.dispose()`，长生命周期 child shell 必须 `agent.stop()`；\nstop 幂等，并在任一 child 无法清理时报告 aggregate lifecycle failure。"},"562":{"id":"/zh/docs/runtime/iframe-deployment-25","page_id":"/zh/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/zh/docs/runtime/iframe-deployment#上线清单与验证","content":"agent origin 与每个 shell origin 不同；src/targetOrigin/allowedOrigins 精确且按环境配置。"},"563":{"id":"/zh/docs/runtime/iframe-deployment-26","page_id":"/zh/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/zh/docs/runtime/iframe-deployment#上线清单与验证","content":"仅保留必需 sandbox token，CSP、frame-ancestors、CORS 和 `allow` 全部显式。"},"564":{"id":"/zh/docs/runtime/iframe-deployment-27","page_id":"/zh/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/zh/docs/runtime/iframe-deployment#上线清单与验证","content":"source、metadata、props、RPC 参数/结果可 structured clone，artifact 为 HTTPS 不可变地址。"},"565":{"id":"/zh/docs/runtime/iframe-deployment-28","page_id":"/zh/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/zh/docs/runtime/iframe-deployment#上线清单与验证","content":"三方 capability 交集符合意图，特权服务校验、绑定身份、限流并审计。"},"566":{"id":"/zh/docs/runtime/iframe-deployment-29","page_id":"/zh/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/zh/docs/runtime/iframe-deployment#上线清单与验证","content":"三个 timeout 符合 SLO，parent/child shutdown 分别调用 dispose/stop。"},"567":{"id":"/zh/docs/runtime/iframe-deployment-30","page_id":"/zh/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/zh/docs/runtime/iframe-deployment#上线清单与验证","content":"不同 origin 的浏览器 E2E 证明 mount、ready、service、update、navigation 和 cleanup。"},"568":{"id":"/zh/docs/runtime/iframe-deployment-31","page_id":"/zh/docs/runtime/iframe-deployment","tags":[],"type":"text","url":"/zh/docs/runtime/iframe-deployment#上线清单与验证","content":"Fronts iframe 不提供 SES/Realm confinement、network interception、storage partition 或依赖完整性校验。\n生产 origin、CSP、cookie、权限和 service authorization 必须人工评审，仓库测试无法证明部署 header。"},"569":{"id":"/zh/docs/runtime/isolation-security","page_id":"/zh/docs/runtime/isolation-security","type":"page","content":"隔离与安全","breadcrumbs":["Fronts 2.0 文档","运行时指南","运行时指南"],"tags":[],"url":"/zh/docs/runtime/isolation-security"},"570":{"id":"/zh/docs/runtime/isolation-security-0","page_id":"/zh/docs/runtime/isolation-security","tags":[],"type":"text","url":"/zh/docs/runtime/isolation-security","content":"信任模型、DOM 与 realm 隔离、iframe 协议权威、capability service 和供应链边界。"},"571":{"id":"/zh/docs/runtime/isolation-security-1","page_id":"/zh/docs/runtime/isolation-security","type":"heading","tags":[],"url":"/zh/docs/runtime/isolation-security#威胁模型","content":"威胁模型"},"572":{"id":"/zh/docs/runtime/isolation-security-2","page_id":"/zh/docs/runtime/isolation-security","type":"heading","tags":[],"url":"/zh/docs/runtime/isolation-security#容器对照","content":"容器对照"},"573":{"id":"/zh/docs/runtime/isolation-security-3","page_id":"/zh/docs/runtime/isolation-security","type":"heading","tags":[],"url":"/zh/docs/runtime/isolation-security#dom-与-shadow-dom","content":"DOM 与 Shadow DOM"},"574":{"id":"/zh/docs/runtime/isolation-security-4","page_id":"/zh/docs/runtime/isolation-security","type":"heading","tags":[],"url":"/zh/docs/runtime/isolation-security#iframe-容器与-agent","content":"Iframe 容器与 agent"},"575":{"id":"/zh/docs/runtime/isolation-security-5","page_id":"/zh/docs/runtime/isolation-security","type":"heading","tags":[],"url":"/zh/docs/runtime/isolation-security#sandbox-与-origin","content":"Sandbox 与 origin"},"576":{"id":"/zh/docs/runtime/isolation-security-6","page_id":"/zh/docs/runtime/isolation-security","type":"heading","tags":[],"url":"/zh/docs/runtime/isolation-security#capability-scoped-services","content":"Capability-scoped services"},"577":{"id":"/zh/docs/runtime/isolation-security-7","page_id":"/zh/docs/runtime/isolation-security","type":"heading","tags":[],"url":"/zh/docs/runtime/isolation-security#供应链清单与非目标","content":"供应链清单与非目标"},"578":{"id":"/zh/docs/runtime/isolation-security-8","page_id":"/zh/docs/runtime/isolation-security","type":"heading","tags":[],"url":"/zh/docs/runtime/isolation-security#验证","content":"验证"},"579":{"id":"/zh/docs/runtime/isolation-security-9","page_id":"/zh/docs/runtime/isolation-security","tags":[],"type":"text","url":"/zh/docs/runtime/isolation-security#威胁模型","content":"Fronts 假设独立交付的应用可能有缺陷，也可能具有不同信任级别。它降低意外干扰并约束显式 Host\nAPI，但绝不声称同 realm JavaScript 是安全 sandbox。安全评估必须分别处理三面：允许执行哪份代码\n（provenance）、代码可访问哪些 globals/DOM（execution realm）、应用能调用哪些宿主操作（authority）。"},"580":{"id":"/zh/docs/runtime/isolation-security-10","page_id":"/zh/docs/runtime/isolation-security","tags":[],"type":"text","url":"/zh/docs/runtime/isolation-security#容器对照","content":"容器"},"581":{"id":"/zh/docs/runtime/isolation-security-11","page_id":"/zh/docs/runtime/isolation-security","tags":[],"type":"text","url":"/zh/docs/runtime/isolation-security#容器对照","content":"CSS 隔离"},"582":{"id":"/zh/docs/runtime/isolation-security-12","page_id":"/zh/docs/runtime/isolation-security","tags":[],"type":"text","url":"/zh/docs/runtime/isolation-security#容器对照","content":"JS realm 隔离"},"583":{"id":"/zh/docs/runtime/isolation-security-13","page_id":"/zh/docs/runtime/isolation-security","tags":[],"type":"text","url":"/zh/docs/runtime/isolation-security#容器对照","content":"Host service"},"584":{"id":"/zh/docs/runtime/isolation-security-14","page_id":"/zh/docs/runtime/isolation-security","tags":[],"type":"text","url":"/zh/docs/runtime/isolation-security#容器对照","content":"典型用途"},"585":{"id":"/zh/docs/runtime/isolation-security-15","page_id":"/zh/docs/runtime/isolation-security","tags":[],"type":"text","url":"/zh/docs/runtime/isolation-security#容器对照","content":"DOM"},"586":{"id":"/zh/docs/runtime/isolation-security-16","page_id":"/zh/docs/runtime/isolation-security","tags":[],"type":"text","url":"/zh/docs/runtime/isolation-security#容器对照","content":"仅靠 producer 约定"},"587":{"id":"/zh/docs/runtime/isolation-security-17","page_id":"/zh/docs/runtime/isolation-security","tags":[],"type":"text","url":"/zh/docs/runtime/isolation-security#容器对照","content":"无"},"588":{"id":"/zh/docs/runtime/isolation-security-18","page_id":"/zh/docs/runtime/isolation-security","tags":[],"type":"text","url":"/zh/docs/runtime/isolation-security#容器对照","content":"直接 scoped object"},"589":{"id":"/zh/docs/runtime/isolation-security-19","page_id":"/zh/docs/runtime/isolation-security","tags":[],"type":"text","url":"/zh/docs/runtime/isolation-security#容器对照","content":"同设计系统的可信应用"},"590":{"id":"/zh/docs/runtime/isolation-security-20","page_id":"/zh/docs/runtime/isolation-security","tags":[],"type":"text","url":"/zh/docs/runtime/isolation-security#容器对照","content":"Shadow DOM"},"591":{"id":"/zh/docs/runtime/isolation-security-21","page_id":"/zh/docs/runtime/isolation-security","tags":[],"type":"text","url":"/zh/docs/runtime/isolation-security#容器对照","content":"强 selector 边界，但有继承/逃逸限制"},"592":{"id":"/zh/docs/runtime/isolation-security-22","page_id":"/zh/docs/runtime/isolation-security","tags":[],"type":"text","url":"/zh/docs/runtime/isolation-security#容器对照","content":"无"},"593":{"id":"/zh/docs/runtime/isolation-security-23","page_id":"/zh/docs/runtime/isolation-security","tags":[],"type":"text","url":"/zh/docs/runtime/isolation-security#容器对照","content":"直接 scoped object"},"594":{"id":"/zh/docs/runtime/isolation-security-24","page_id":"/zh/docs/runtime/isolation-security","tags":[],"type":"text","url":"/zh/docs/runtime/isolation-security#容器对照","content":"可信代码的样式封装"},"595":{"id":"/zh/docs/runtime/isolation-security-25","page_id":"/zh/docs/runtime/isolation-security","tags":[],"type":"text","url":"/zh/docs/runtime/isolation-security#容器对照","content":"iframe"},"596":{"id":"/zh/docs/runtime/isolation-security-26","page_id":"/zh/docs/runtime/isolation-security","tags":[],"type":"text","url":"/zh/docs/runtime/isolation-security#容器对照","content":"document/origin 边界"},"597":{"id":"/zh/docs/runtime/isolation-security-27","page_id":"/zh/docs/runtime/isolation-security","tags":[],"type":"text","url":"/zh/docs/runtime/isolation-security#容器对照","content":"独立 realm，强度取决于 sandbox/origin"},"598":{"id":"/zh/docs/runtime/isolation-security-28","page_id":"/zh/docs/runtime/isolation-security","tags":[],"type":"text","url":"/zh/docs/runtime/isolation-security#容器对照","content":"scoped RPC"},"599":{"id":"/zh/docs/runtime/isolation-security-29","page_id":"/zh/docs/runtime/isolation-security","tags":[],"type":"text","url":"/zh/docs/runtime/isolation-security#容器对照","content":"较低信任或依赖冲突应用"},"600":{"id":"/zh/docs/runtime/isolation-security-30","page_id":"/zh/docs/runtime/isolation-security","tags":[],"type":"text","url":"/zh/docs/runtime/isolation-security#容器对照","content":"官方 Module Federation 不自动做 CSS 隔离，因为 shared dependency 和 runtime 注入样式让所有权模糊。\nFronts 同样不抓取或搬运 parent document 中的 style；Shadow container 只提供 shadow target。"},"601":{"id":"/zh/docs/runtime/isolation-security-31","page_id":"/zh/docs/runtime/isolation-security","tags":[],"type":"text","url":"/zh/docs/runtime/isolation-security#dom-与-shadow-dom","content":"DOM adapter 创建并拥有带 tag、class、attributes 和 Fronts identity data 的子元素，先卸载应用再\n移除元素。它只适合允许共享页面的可信代码：应用仍能访问 `window`、`document`、页面 cookie 和\ntarget 外 DOM。通用 DOM attribute 交给浏览器验证，Fronts 不把它描述成同 realm 安全 allowlist。"},"602":{"id":"/zh/docs/runtime/isolation-security-32","page_id":"/zh/docs/runtime/isolation-security","tags":[],"type":"text","url":"/zh/docs/runtime/isolation-security#dom-与-shadow-dom","content":"Shadow adapter 创建 host element，并 attach open/closed shadow root。producer 必须用 inline style、\nconstructable stylesheet、指向 shadow root 的 CSS-in-JS 或 custom element。Shadow DOM 不隔离 JS\nglobals、network、storage、继承属性和 CSS variable、渲染到外部的 portal 或 shared singleton state；\n它是样式/DOM 封装，不是 hostile-code boundary。"},"603":{"id":"/zh/docs/runtime/isolation-security-33","page_id":"/zh/docs/runtime/isolation-security","tags":[],"type":"text","url":"/zh/docs/runtime/isolation-security#iframe-容器与-agent","content":"parent 负责解析策略、创建 iframe、授权 capability 和代理 lifecycle；child agent 拥有独立 loader\n与 MF instance，在 child document 内加载、验证和挂载；RPC 用不可预测 channel ID 与协议版本关联。"},"604":{"id":"/zh/docs/runtime/isolation-security-34","page_id":"/zh/docs/runtime/isolation-security","tags":[],"type":"text","url":"/zh/docs/runtime/isolation-security#iframe-容器与-agent","content":"必需控制包括：精确 `targetOrigin`，拒绝通配；只在 connect 消息中 transfer 专用 `MessagePort`，\nchild 校验 sender origin/source；agent 有 exact parent allowlist；sandbox 保留专用 child origin；Host\n显式选择 `allow`；真实应用加载后只协商一次 capability；每次调用校验 capability 和 method；参数/\n结果可 structured clone；connection/lifecycle timeout 有限且可配置（`0` 明确关闭 deadline）；dispose\n关闭 channel 并 reject pending promise。"},"605":{"id":"/zh/docs/runtime/isolation-security-35","page_id":"/zh/docs/runtime/isolation-security","tags":[],"type":"text","url":"/zh/docs/runtime/isolation-security#iframe-容器与-agent","content":"child 自建 MF instance，避免 parent 先执行 remote 再假装 iframe 提供隔离。shared dependency 因此\n限于 child runtime，以一些重复换取真正 realm isolation。"},"606":{"id":"/zh/docs/runtime/isolation-security-36","page_id":"/zh/docs/runtime/isolation-security","tags":[],"type":"text","url":"/zh/docs/runtime/isolation-security#sandbox-与-origin","content":"精确 origin handshake 需要 `allow-scripts` 和 `allow-same-origin`：opaque sandbox origin 无法接收\n发往部署 exact origin 的 connect 消息，而 Fronts 不会降级到 `targetOrigin=\"*\"`。agent 必须部署在\n不同于 shell 的专用 origin；跨源时 allow-same-origin 只保留 child 自己的 origin，不赋予 parent\norigin 访问。绝不能把同配置移到 shell origin。"},"607":{"id":"/zh/docs/runtime/isolation-security-37","page_id":"/zh/docs/runtime/isolation-security","tags":[],"type":"text","url":"/zh/docs/runtime/isolation-security#sandbox-与-origin","content":"默认 sandbox 就是这两个 token；其他 browser permission 与 token 必须逐项授权。CSP、Trusted Types、\nCOOP/COEP、cookie 和 server header 仍由部署负责。generic attributes 不能覆盖 `src`、`sandbox`、\n`allow` 等 typed fields、Fronts `data-*` 或 inline `on*` handler。"},"608":{"id":"/zh/docs/runtime/isolation-security-38","page_id":"/zh/docs/runtime/isolation-security","tags":[],"type":"text","url":"/zh/docs/runtime/isolation-security#capability-scoped-services","content":"producer 声明 `capabilities: ['navigation', 'telemetry']`，Host 再按可信 identity 与 signal 授权。\n需要实例、tenant、deployment、trace 绑定时使用 `createServices`；它得到 Host-issued context，并可返回\nasync disposer。静态与 provider service 合并（provider 优先），再做 policy。最终 scope 只暴露允许的\nown key，拒绝 prototype-mutating 名称；abort/unmount 立即 revoke proxy，然后 dispose provider 一次。"},"609":{"id":"/zh/docs/runtime/isolation-security-39","page_id":"/zh/docs/runtime/isolation-security","tags":[],"type":"text","url":"/zh/docs/runtime/isolation-security#capability-scoped-services","content":"iframe authority 是三者交集：proxy 配置的最大集合、parent 实例 scope 实际授权服务、child 真实应用\n声明。最大集合只是上限，不是 proxy 的 mandatory dependency。协议 v2 中 child 加载后提交自己的\n声明，parent 锁定一次 grant；child 只为 exact grant 创建 RPC stub，parent 每次 `service.call` 又独立\n检查。协商前调用、重复协商或 grant 外调用都 fail closed；child 从未得到原始 service object。"},"610":{"id":"/zh/docs/runtime/isolation-security-40","page_id":"/zh/docs/runtime/isolation-security","tags":[],"type":"text","url":"/zh/docs/runtime/isolation-security#capability-scoped-services","content":"service 应暴露意图而不是 ambient authority；Host 实现校验参数并把可信 identity/tenant 绑定在闭包，\n限制敏感/昂贵调用并审计。不要暴露 raw token、storage、unrestricted `fetch`、DOM root、泛化\n`eval/execute` 或整份全局 store。provider 必须 abort-aware，返回前抛错要自行回滚部分分配。"},"611":{"id":"/zh/docs/runtime/isolation-security-41","page_id":"/zh/docs/runtime/isolation-security","tags":[],"type":"text","url":"/zh/docs/runtime/isolation-security#供应链清单与非目标","content":"registry、manifest、entry、chunk、iframe agent 全部用 HTTPS 与不可变 URL；限制 CDN 写权限；在流水线\n做签名/attestation、依赖与 license 扫描；CSP 明确 script/connect/frame origin；registry response\n必须认证授权；保留上一版本 artifact；把 registry deployment ID、MF loading trace 和 Fronts trace ID\n关联起来。"},"612":{"id":"/zh/docs/runtime/isolation-security-42","page_id":"/zh/docs/runtime/isolation-security","tags":[],"type":"text","url":"/zh/docs/runtime/isolation-security#供应链清单与非目标","content":"Fronts 不实现 SES、Realm、DOM membrane virtualization、network interception 或完整 browser sandbox。\n不可信代码应放入加固的跨源 iframe，或者更独立的应用/执行边界。"},"613":{"id":"/zh/docs/runtime/isolation-security-43","page_id":"/zh/docs/runtime/isolation-security","tags":[],"type":"text","url":"/zh/docs/runtime/isolation-security#验证","content":"container/services 单测证明 DOM/Shadow 所有权、capability filtering、revocation 和 provider cleanup；\niframe 单测证明 origin/source、协议、grant、取消和清理；两套浏览器 E2E 在真实不同 origin 中验证边界。"},"614":{"id":"/zh/docs/runtime/module-federation","page_id":"/zh/docs/runtime/module-federation","type":"page","content":"Module Federation 集成","breadcrumbs":["Fronts 2.0 文档","运行时指南","运行时指南"],"tags":[],"url":"/zh/docs/runtime/module-federation"},"615":{"id":"/zh/docs/runtime/module-federation-0","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation","content":"Fronts 使用 Module Federation 交付时的所有权边界、producer 兼容等级与验证路径。"},"616":{"id":"/zh/docs/runtime/module-federation-1","page_id":"/zh/docs/runtime/module-federation","type":"heading","tags":[],"url":"/zh/docs/runtime/module-federation#目的与所有权","content":"目的与所有权"},"617":{"id":"/zh/docs/runtime/module-federation-2","page_id":"/zh/docs/runtime/module-federation","type":"heading","tags":[],"url":"/zh/docs/runtime/module-federation#兼容等级","content":"兼容等级"},"618":{"id":"/zh/docs/runtime/module-federation-3","page_id":"/zh/docs/runtime/module-federation","type":"heading","tags":[],"url":"/zh/docs/runtime/module-federation#集成矩阵","content":"集成矩阵"},"619":{"id":"/zh/docs/runtime/module-federation-4","page_id":"/zh/docs/runtime/module-federation","type":"heading","tags":[],"url":"/zh/docs/runtime/module-federation#官方-rsbuild-与-vite-producer","content":"官方 Rsbuild 与 Vite producer"},"620":{"id":"/zh/docs/runtime/module-federation-5","page_id":"/zh/docs/runtime/module-federation","type":"heading","tags":[],"url":"/zh/docs/runtime/module-federation#vite-plugin-federation","content":"`vite-plugin-federation`"},"621":{"id":"/zh/docs/runtime/module-federation-6","page_id":"/zh/docs/runtime/module-federation","type":"heading","tags":[],"url":"/zh/docs/runtime/module-federation#originjs-的窄边界","content":"OriginJS 的窄边界"},"622":{"id":"/zh/docs/runtime/module-federation-7","page_id":"/zh/docs/runtime/module-federation","type":"heading","tags":[],"url":"/zh/docs/runtime/module-federation#依赖选择","content":"依赖选择"},"623":{"id":"/zh/docs/runtime/module-federation-8","page_id":"/zh/docs/runtime/module-federation","type":"heading","tags":[],"url":"/zh/docs/runtime/module-federation#增加新-producer-的完成条件","content":"增加新 producer 的完成条件"},"624":{"id":"/zh/docs/runtime/module-federation-9","page_id":"/zh/docs/runtime/module-federation","type":"heading","tags":[],"url":"/zh/docs/runtime/module-federation#验证","content":"验证"},"625":{"id":"/zh/docs/runtime/module-federation-10","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#目的与所有权","content":"Fronts core 不依赖 Module Federation。只有选择 MF 作为交付 transport 时，才使用 `@fronts/mf`\n把一个显式传入的官方 Runtime instance 适配到 Fronts loader；它不实现第二套 manifest parser、share\nresolver、remote registry 或 bundler plugin。"},"626":{"id":"/zh/docs/runtime/module-federation-11","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#目的与所有权","content":"Fronts 选择部署并治理应用生命周期；官方 Runtime 负责 remote 注册、manifest 解释、expose 加载和\nshared dependency。Host 必须把显式官方 instance 传给 adapter。producer 必须 expose 有效\n`FrontsApp`（通常是 `./application`）；只有 React/Vue component 不满足契约。Fronts 不依赖 producer\n插件私有/virtual Host API，不推断或改写 share graph。部署应使用不可变 remote name，因为 Runtime\n会缓存 registration 与 loaded module。"},"627":{"id":"/zh/docs/runtime/module-federation-12","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#兼容等级","content":"等级"},"628":{"id":"/zh/docs/runtime/module-federation-13","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#兼容等级","content":"含义"},"629":{"id":"/zh/docs/runtime/module-federation-14","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#兼容等级","content":"Core-native"},"630":{"id":"/zh/docs/runtime/module-federation-15","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#兼容等级","content":"不依赖 MF；自定义 `AppLoader` 提供相同 Fronts protocol"},"631":{"id":"/zh/docs/runtime/module-federation-16","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#兼容等级","content":"Official integration"},"632":{"id":"/zh/docs/runtime/module-federation-17","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#兼容等级","content":"官方 Runtime + 官方 producer plugin，仓库集成与 E2E 覆盖"},"633":{"id":"/zh/docs/runtime/module-federation-18","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#兼容等级","content":"Verified producer compatibility"},"634":{"id":"/zh/docs/runtime/module-federation-19","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#兼容等级","content":"第三方产物由官方 Runtime 消费，并通过规定的 Fronts 生命周期 E2E"},"635":{"id":"/zh/docs/runtime/module-federation-20","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#兼容等级","content":"Narrow compatibility fixture"},"636":{"id":"/zh/docs/runtime/module-federation-21","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#兼容等级","content":"只承诺仓库锁定的版本、输出格式和运行模式，不泛化为整个插件支持"},"637":{"id":"/zh/docs/runtime/module-federation-22","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#兼容等级","content":"“Verified”只说明仓库证明了表中路径，不把第三方插件所有权转移给 Fronts，也不承诺所有版本和输出格式。"},"638":{"id":"/zh/docs/runtime/module-federation-23","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#集成矩阵","content":"交付路径"},"639":{"id":"/zh/docs/runtime/module-federation-24","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#集成矩阵","content":"Host loader"},"640":{"id":"/zh/docs/runtime/module-federation-25","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#集成矩阵","content":"Producer 产物"},"641":{"id":"/zh/docs/runtime/module-federation-26","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#集成矩阵","content":"开发模式"},"642":{"id":"/zh/docs/runtime/module-federation-27","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#集成矩阵","content":"production preview"},"643":{"id":"/zh/docs/runtime/module-federation-28","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#集成矩阵","content":"等级"},"644":{"id":"/zh/docs/runtime/module-federation-29","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#集成矩阵","content":"自定义 loader、无 MF"},"645":{"id":"/zh/docs/runtime/module-federation-30","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#集成矩阵","content":"用户 `AppLoader`"},"646":{"id":"/zh/docs/runtime/module-federation-31","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#集成矩阵","content":"任意有效 FrontsApp source"},"647":{"id":"/zh/docs/runtime/module-federation-32","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#集成矩阵","content":"是"},"648":{"id":"/zh/docs/runtime/module-federation-33","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#集成矩阵","content":"是"},"649":{"id":"/zh/docs/runtime/module-federation-34","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#集成矩阵","content":"Core-native"},"650":{"id":"/zh/docs/runtime/module-federation-35","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#集成矩阵","content":"`@module-federation/rsbuild-plugin`"},"651":{"id":"/zh/docs/runtime/module-federation-36","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#集成矩阵","content":"`@fronts/mf` + 官方 Runtime"},"652":{"id":"/zh/docs/runtime/module-federation-37","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#集成矩阵","content":"MF manifest"},"653":{"id":"/zh/docs/runtime/module-federation-38","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#集成矩阵","content":"是"},"654":{"id":"/zh/docs/runtime/module-federation-39","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#集成矩阵","content":"是"},"655":{"id":"/zh/docs/runtime/module-federation-40","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#集成矩阵","content":"Official integration"},"656":{"id":"/zh/docs/runtime/module-federation-41","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#集成矩阵","content":"`@module-federation/vite`"},"657":{"id":"/zh/docs/runtime/module-federation-42","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#集成矩阵","content":"无 federation plugin 的 Vite shell + 官方 Runtime"},"658":{"id":"/zh/docs/runtime/module-federation-43","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#集成矩阵","content":"MF manifest"},"659":{"id":"/zh/docs/runtime/module-federation-44","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#集成矩阵","content":"是"},"660":{"id":"/zh/docs/runtime/module-federation-45","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#集成矩阵","content":"是"},"661":{"id":"/zh/docs/runtime/module-federation-46","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#集成矩阵","content":"Official integration"},"662":{"id":"/zh/docs/runtime/module-federation-47","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#集成矩阵","content":"`vite-plugin-federation`"},"663":{"id":"/zh/docs/runtime/module-federation-48","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#集成矩阵","content":"同一 plain shell + 官方 Runtime"},"664":{"id":"/zh/docs/runtime/module-federation-49","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#集成矩阵","content":"MF manifest"},"665":{"id":"/zh/docs/runtime/module-federation-50","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#集成矩阵","content":"是"},"666":{"id":"/zh/docs/runtime/module-federation-51","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#集成矩阵","content":"是"},"667":{"id":"/zh/docs/runtime/module-federation-52","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#集成矩阵","content":"Verified producer compatibility"},"668":{"id":"/zh/docs/runtime/module-federation-53","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#集成矩阵","content":"`@originjs/vite-plugin-federation`"},"669":{"id":"/zh/docs/runtime/module-federation-54","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#集成矩阵","content":"同一 plain shell + 官方 Runtime"},"670":{"id":"/zh/docs/runtime/module-federation-55","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#集成矩阵","content":"ESM `remoteEntry.js`"},"671":{"id":"/zh/docs/runtime/module-federation-56","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#集成矩阵","content":"build + preview"},"672":{"id":"/zh/docs/runtime/module-federation-57","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#集成矩阵","content":"是"},"673":{"id":"/zh/docs/runtime/module-federation-58","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#集成矩阵","content":"Narrow fixture"},"674":{"id":"/zh/docs/runtime/module-federation-59","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#集成矩阵","content":"所有 Vite 路径都复用 `examples/vite-host` 的普通 Vite Host。Host 不安装 federation build plugin，\n而是在运行时创建官方 instance 并交给 `@fronts/mf`。"},"675":{"id":"/zh/docs/runtime/module-federation-60","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#官方-rsbuild-与-vite-producer","content":"两者是首选路径，并输出由官方 Runtime 消费的 manifest。相较裸 entry，manifest 保留预加载、\nsnapshot、类型提示和 DevTools 需要的 metadata；Fronts 不直接读取内部字段。仓库证明官方 Rsbuild\n暴露 React/Vue 应用，官方 Vite 暴露框架无关应用，并验证 mount、framework readiness、update、\nHost service、unmount，以及完整示例中的 DOM、Shadow DOM 和跨源 iframe。"},"676":{"id":"/zh/docs/runtime/module-federation-61","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#vite-plugin-federation","content":"未加 scope 的插件作为兼容 producer 支持，不是 Fronts Host runtime。fixture 输出\n`mf-manifest.json`，Host 通过自己的官方 Runtime instance 消费；插件自带 runtime 不能传给\n`@fronts/mf`。同一 lifecycle E2E 覆盖 Vite dev server 与全新 production preview，承诺范围只限\n仓库中 manifest producer 路径。"},"677":{"id":"/zh/docs/runtime/module-federation-62","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#originjs-的窄边界","content":"OriginJS fixture 以 ESM 构建并从 `assets/remoteEntry.js` 加载。由于没有可用的 bundleless remote\ndev，fixture 的 `dev` 实际是 build + preview；它固定 Vite 5.4，因为当前 transform 与仓库 Vite 8/\nRolldown producer pipeline 不兼容。生成的 `@fronts/core` fallback 被保留，并通过 share-scope\n初始化验证。Fronts 不使用或支持 OriginJS `virtual:__federation__` Host API。"},"678":{"id":"/zh/docs/runtime/module-federation-63","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#originjs-的窄边界","content":"这不代表支持 SystemJS/`var` 输出、OriginJS 充当 Host loader 或任意更新版 Vite pipeline。扩展\n声明必须新建 fixture，同时验证 lifecycle 与 shared dependency。"},"679":{"id":"/zh/docs/runtime/module-federation-64","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#依赖选择","content":"场景"},"680":{"id":"/zh/docs/runtime/module-federation-65","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#依赖选择","content":"Consumer 依赖"},"681":{"id":"/zh/docs/runtime/module-federation-66","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#依赖选择","content":"Fronts 不使用 MF"},"682":{"id":"/zh/docs/runtime/module-federation-67","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#依赖选择","content":"`@fronts/core`"},"683":{"id":"/zh/docs/runtime/module-federation-68","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#依赖选择","content":"Fronts Host 加载 MF remote"},"684":{"id":"/zh/docs/runtime/module-federation-69","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#依赖选择","content":"`@fronts/core`、`@fronts/mf`、`@module-federation/runtime`"},"685":{"id":"/zh/docs/runtime/module-federation-70","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#依赖选择","content":"React/Vue producer"},"686":{"id":"/zh/docs/runtime/module-federation-71","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#依赖选择","content":"对应 Fronts adapter、框架、选择的 MF producer plugin"},"687":{"id":"/zh/docs/runtime/module-federation-72","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#依赖选择","content":"框架无关官方 Vite remote"},"688":{"id":"/zh/docs/runtime/module-federation-73","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#依赖选择","content":"`@fronts/core`、`@module-federation/vite`"},"689":{"id":"/zh/docs/runtime/module-federation-74","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#依赖选择","content":"第三方 Vite producer"},"690":{"id":"/zh/docs/runtime/module-federation-75","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#依赖选择","content":"core 或框架 adapter + producer plugin；不增加 Fronts Runtime API"},"691":{"id":"/zh/docs/runtime/module-federation-76","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#依赖选择","content":"精确 peer range 以 package manifest 为准。"},"692":{"id":"/zh/docs/runtime/module-federation-77","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#增加新-producer-的完成条件","content":"新兼容声明必须：expose 有效 `./application`；由 plain Host 的显式官方 instance 加载；测试\nmount/readiness、Host service、update、unmount 和 idle audit；产物带 share graph/fallback 时验证\nshared 行为；分别记录 dev 与 production，不能用未支持模式扩大声明；从不同 Host origin 验证 CORS\n和 public asset URL；最后在矩阵中写明精确证据边界。仅仅兼容一个 producer artifact 不需要新增\nFronts Runtime API。"},"693":{"id":"/zh/docs/runtime/module-federation-78","page_id":"/zh/docs/runtime/module-federation","tags":[],"type":"text","url":"/zh/docs/runtime/module-federation#验证","content":"MF 单测验证 source、官方 instance 调用、不可变绑定、preload、取消和真实 remote container；\n`pnpm test:e2e` 覆盖开发命令，`pnpm test:e2e:preview` 重建所有 producer 后覆盖生产产物。\n`vite-runtime.spec.ts`、`originjs-runtime.spec.ts` 和 `vertical-slice.spec.ts` 分别提供对应证据。"},"694":{"id":"/zh/docs/runtime/resolution-delivery","page_id":"/zh/docs/runtime/resolution-delivery","type":"page","content":"解析与交付","breadcrumbs":["Fronts 2.0 文档","运行时指南","运行时指南"],"tags":[],"url":"/zh/docs/runtime/resolution-delivery"},"695":{"id":"/zh/docs/runtime/resolution-delivery-0","page_id":"/zh/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/zh/docs/runtime/resolution-delivery","content":"部署解析、策略上下文、缓存、预加载、不可变发布、回滚，以及 transport 所有权。"},"696":{"id":"/zh/docs/runtime/resolution-delivery-1","page_id":"/zh/docs/runtime/resolution-delivery","type":"heading","tags":[],"url":"/zh/docs/runtime/resolution-delivery#策略与加载必须分离","content":"策略与加载必须分离"},"697":{"id":"/zh/docs/runtime/resolution-delivery-2","page_id":"/zh/docs/runtime/resolution-delivery","type":"heading","tags":[],"url":"/zh/docs/runtime/resolution-delivery#resolver-组合与-registry","content":"Resolver 组合与 registry"},"698":{"id":"/zh/docs/runtime/resolution-delivery-3","page_id":"/zh/docs/runtime/resolution-delivery","type":"heading","tags":[],"url":"/zh/docs/runtime/resolution-delivery#基于解析结果规划容器","content":"基于解析结果规划容器"},"699":{"id":"/zh/docs/runtime/resolution-delivery-4","page_id":"/zh/docs/runtime/resolution-delivery","type":"heading","tags":[],"url":"/zh/docs/runtime/resolution-delivery#module-federation-source-规则","content":"Module Federation source 规则"},"700":{"id":"/zh/docs/runtime/resolution-delivery-5","page_id":"/zh/docs/runtime/resolution-delivery","type":"heading","tags":[],"url":"/zh/docs/runtime/resolution-delivery#版本channel-与缓存策略","content":"版本、channel 与缓存策略"},"701":{"id":"/zh/docs/runtime/resolution-delivery-6","page_id":"/zh/docs/runtime/resolution-delivery","type":"heading","tags":[],"url":"/zh/docs/runtime/resolution-delivery#预加载安全发布与回滚","content":"预加载、安全发布与回滚"},"702":{"id":"/zh/docs/runtime/resolution-delivery-7","page_id":"/zh/docs/runtime/resolution-delivery","type":"heading","tags":[],"url":"/zh/docs/runtime/resolution-delivery#非目标与验证","content":"非目标与验证"},"703":{"id":"/zh/docs/runtime/resolution-delivery-8","page_id":"/zh/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/zh/docs/runtime/resolution-delivery#策略与加载必须分离","content":"逻辑引用不应随着 CDN 搬迁、版本提升、tenant override 或 bundler 更换而变化："},"704":{"id":"/zh/docs/runtime/resolution-delivery-9","page_id":"/zh/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/zh/docs/runtime/resolution-delivery#策略与加载必须分离","content":"resolver 将两者变成一个具体、不可变结果，例如版本 `2.4.3`、唯一 remote 名称、版本化\n`mf-manifest.json` 和 deployment ID。loader 不重新运行任何业务策略，只执行已经解析的 source。"},"705":{"id":"/zh/docs/runtime/resolution-delivery-10","page_id":"/zh/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/zh/docs/runtime/resolution-delivery#resolver-组合与-registry","content":"Fronts 提供 `createStaticResolver()`（测试、本地与确定性 fallback）、`createRegistryResolver()`\n（HTTP registry）、带 fresh/stale 窗口的 `createCachedResolver()`、顺序 fallback resolver 和可插拔\n`ResolutionCache`/内存实现。默认 cache key 包含 name、expose、range、channel、environment、tenant\n与 cohort；若自定义 metadata 参与版本选择，必须提供自定义 key，否则不同策略上下文可能误用同一决策。"},"706":{"id":"/zh/docs/runtime/resolution-delivery-11","page_id":"/zh/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/zh/docs/runtime/resolution-delivery#resolver-组合与-registry","content":"内置 registry resolver 通过 GET 发送存在的 `name, expose, range, channel, environment, tenant,\ncohort`。最小响应包含 `source`，还可包含 `version` 和 `metadata`。认证 header、credential、endpoint\n计算、fetch 与 payload decoding 均可注入。服务端必须认证 caller 并验证所有 policy input，浏览器 query\n绝不能证明 tenant/cohort 成员身份。"},"707":{"id":"/zh/docs/runtime/resolution-delivery-12","page_id":"/zh/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/zh/docs/runtime/resolution-delivery#基于解析结果规划容器","content":"registry 返回具体部署后，mount 才能从 metadata 决定执行边界；planner 在同一 transaction 内、\ncontainer-specific loader 选择之前运行："},"708":{"id":"/zh/docs/runtime/resolution-delivery-13","page_id":"/zh/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/zh/docs/runtime/resolution-delivery#基于解析结果规划容器","content":"在构造 request 前必须校验外部 metadata。Fronts 会快照 request，通过 `containerLoaders` 选择\nloader，并把同一份冻结 `ResolvedApp` 交给 prepare context，避免计划与执行使用不同决策。"},"709":{"id":"/zh/docs/runtime/resolution-delivery-14","page_id":"/zh/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/zh/docs/runtime/resolution-delivery#module-federation-source-规则","content":"`@fronts/mf` 接受官方 `Remote` 形状的 entry-based 或 version-based remote。它在调用者提供的 MF\ninstance 上注册具体 remote，根据 source 和规范化 ref 生成 `remoteName/expose`，调用\n`loadRemote(id, { from: 'runtime' })`，把 null/异常映射为 Fronts load error，并在 preload 时调用\n`preloadRemote()`。同一 instance 内，已观察到的 remote name 若绑定到不同 source 或已知版本会被\n拒绝，除非调用者明确 force replacement。"},"710":{"id":"/zh/docs/runtime/resolution-delivery-15","page_id":"/zh/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/zh/docs/runtime/resolution-delivery#module-federation-source-规则","content":"优先 manifest，而不是裸 remote entry，因为 manifest 保留官方预加载、snapshot、类型提示和\nDevTools 所需的资源及 shared metadata。Fronts 把这些内容当作 MF-owned opaque data，绝不修改\n全局 snapshot。"},"711":{"id":"/zh/docs/runtime/resolution-delivery-16","page_id":"/zh/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/zh/docs/runtime/resolution-delivery#版本channel-与缓存策略","content":"registry 应只用不可变已发布版本满足 semantic range；在服务端把 stable/canary/next channel 映射\n到具体 deployment；以已认证 subject + experiment salt 确定 cohort；返回具体版本、不可变 URL 和\npolicy revision/deployment ID；在同一 MF instance 中不要复用 mutable remote name；至少在回滚窗口\n内保留旧 artifact。Fronts 不规定 registry 数据库或 rollout 算法，这些属于独立可运维的 deployment plane。"},"712":{"id":"/zh/docs/runtime/resolution-delivery-17","page_id":"/zh/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/zh/docs/runtime/resolution-delivery#版本channel-与缓存策略","content":"缓存 fresh TTL 内直接返回；fresh 过期后 refresh 失败，才可在有限 stale TTL 内返回旧解析。它是\n可用性行为，不是静默版本 fallback。每次使用 stale 都应发 telemetry，artifact 必须仍不可变可用，\n且安全撤销不能被长 stale window 绕过；敏感应用需要 kill-switch 或极短 TTL。"},"713":{"id":"/zh/docs/runtime/resolution-delivery-18","page_id":"/zh/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/zh/docs/runtime/resolution-delivery#预加载安全发布与回滚","content":"`host.preload()` 解析相同策略并请求 transport preload，不挂载、不创建 service scope，也不占用\ncontainer。MF preload promise 汇总资源成败；除非产品在导航前必须取得应用，否则 rejection 应视为\n优化失败，而不是运行时已经不可用。"},"714":{"id":"/zh/docs/runtime/resolution-delivery-19","page_id":"/zh/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/zh/docs/runtime/resolution-delivery#预加载安全发布与回滚","content":"安全发布使用不可变 URL + Fronts replacement：registry 向目标 cohort 推广 B；Host 解析 B 并在\nstaging slot 挂载；B 通过协议和 readiness 后才 commit 并卸载 A；若 staging 失败，A 继续活跃；\nregistry 可降级 B，使后续解析返回 A 或修复后的 C。常规 rollout 不要对已活跃 remote 调\n`registerRemotes(..., { force: true })`，因为官方 Runtime 会清理 loaded-module cache；唯一 remote\nname 配合应用级 replace 更容易审计。"},"715":{"id":"/zh/docs/runtime/resolution-delivery-20","page_id":"/zh/docs/runtime/resolution-delivery","tags":[],"type":"text","url":"/zh/docs/runtime/resolution-delivery#非目标与验证","content":"Fronts 不发布 artifact、不签名 manifest、不生成类型、不运营 registry，也不选择 shared 版本。\ncore resolver/host 测试验证规范化、policy snapshot、缓存窗口、取消、preload 与 resolved decision；\nMF adapter 测试证明只调用官方公开注册、预加载和加载 API；replacement 测试证明 promotion/rollback。"}},"count":715},"sorting":{"language":"mandarin","sortableProperties":["content","page_id","type","url"],"sortablePropertiesWithTypes":{"content":"string","page_id":"string","type":"string","url":"string"},"sorts":{"content":{"docs":{"1":512,"2":478,"3":673,"4":490,"5":636,"6":413,"7":712,"8":154,"9":323,"10":273,"11":305,"12":568,"13":639,"14":694,"15":150,"16":353,"17":675,"18":539,"19":367,"20":546,"21":177,"22":149,"23":689,"24":504,"25":414,"26":616,"27":345,"28":6,"29":677,"30":8,"31":576,"32":489,"33":660,"34":158,"35":169,"36":513,"37":410,"38":578,"39":501,"40":188,"41":231,"42":368,"43":656,"44":646,"45":500,"46":153,"47":417,"48":234,"49":235,"50":602,"51":101,"52":585,"53":705,"54":589,"55":226,"56":713,"57":58,"58":61,"59":84,"60":591,"61":502,"62":468,"63":691,"64":268,"65":200,"66":38,"67":416,"68":62,"69":152,"70":666,"71":634,"72":384,"73":580,"74":346,"75":192,"76":571,"77":518,"78":175,"79":383,"80":371,"81":30,"82":78,"83":79,"84":29,"85":34,"86":53,"87":54,"88":643,"89":215,"90":144,"91":214,"92":523,"93":622,"94":282,"95":524,"96":678,"97":303,"98":525,"99":336,"100":295,"101":526,"102":427,"103":480,"104":98,"105":429,"106":679,"107":341,"108":289,"109":659,"110":342,"111":527,"112":136,"113":343,"114":528,"115":190,"116":344,"117":529,"118":320,"119":193,"120":372,"121":74,"122":434,"123":68,"124":216,"125":388,"126":407,"127":482,"128":409,"129":498,"130":425,"131":706,"132":601,"133":151,"134":361,"135":455,"136":484,"137":15,"138":464,"139":503,"140":415,"141":617,"142":481,"143":377,"144":419,"145":676,"146":661,"147":145,"148":533,"149":163,"150":134,"151":155,"152":582,"153":165,"154":393,"155":162,"156":180,"157":229,"158":239,"159":432,"160":473,"161":224,"162":457,"163":459,"164":642,"165":408,"166":65