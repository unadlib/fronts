{
  "name": "fronts",
  "version": "1.0.0-next.0",
  "private": true,
  "description": "A framework-neutral application runtime powered by Module Federation 2.0",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/unadlib/fronts#readme",
  "bugs": {
    "url": "https://github.com/unadlib/fronts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unadlib/fronts.git"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10 <12"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "changeset": "changeset",
    "check": "pnpm lint && pnpm build && pnpm docs:examples && pnpm verify:packages && pnpm typecheck && pnpm test:coverage",
    "clean": "pnpm -r --if-present clean",
    "dev:examples": "pnpm --parallel --filter './examples/*' dev",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:examples": "node scripts/check-doc-examples.mjs",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check . && pnpm docs:check",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:preview": "pnpm build && playwright test --config playwright.preview.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present typecheck",
    "verify:framework-minimums": "node scripts/verify-framework-minimums.mjs",
    "verify:packages": "node scripts/verify-packages.mjs",
    "version-packages": "changeset version",
    "release": "pnpm check && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.10.6",
    "prettier": "^3.9.5",
    "publint": "^0.3.21",
    "tsdown": "^0.22.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vue-tsc": "^3.3.8",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
