{
  "name": "@fronts/vue3",
  "version": "2.0.0-alpha.0",
  "description": "Vue 3 application and host adapters for Fronts",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fronts/core": "workspace:^"
  },
  "peerDependencies": {
    "vue": ">=3.4.0 <4"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.11",
    "vue": "^3.5.39"
  }
}
