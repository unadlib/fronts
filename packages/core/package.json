{
  "name": "@fronts/core",
  "version": "2.0.0-alpha.0",
  "description": "Framework-neutral application protocol and host runtime for Fronts",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./iframe": {
      "import": {
        "types": "./dist/iframe.d.ts",
        "default": "./dist/iframe.js"
      },
      "require": {
        "types": "./dist/iframe.d.cts",
        "default": "./dist/iframe.cjs"
      }
    },
    "./legacy": {
      "import": {
        "types": "./dist/legacy.d.ts",
        "default": "./dist/legacy.js"
      },
      "require": {
        "types": "./dist/legacy.d.cts",
        "default": "./dist/legacy.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json"
  }
}
