{
  "name": "@fronts/core",
  "version": "1.0.0-next.0",
  "description": "Framework-neutral application protocol and host runtime for Fronts",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/unadlib/fronts#readme",
  "bugs": {
    "url": "https://github.com/unadlib/fronts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unadlib/fronts.git",
    "directory": "packages/core"
  },
  "keywords": [
    "micro-frontends",
    "module-federation",
    "runtime",
    "orchestration"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./iframe": {
      "import": {
        "types": "./dist/iframe.d.ts",
        "default": "./dist/iframe.js"
      },
      "require": {
        "types": "./dist/iframe.d.cts",
        "default": "./dist/iframe.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json"
  }
}
