{
  "name": "@fronts/mf",
  "version": "2.0.0-alpha.0",
  "description": "Module Federation 2.0 runtime adapter for Fronts",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/unadlib/fronts#readme",
  "bugs": {
    "url": "https://github.com/unadlib/fronts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unadlib/fronts.git",
    "directory": "packages/mf"
  },
  "keywords": [
    "micro-frontends",
    "module-federation",
    "runtime",
    "adapter"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fronts/core": "workspace:^"
  },
  "peerDependencies": {
    "@module-federation/runtime": "^2.7.0"
  },
  "devDependencies": {
    "@module-federation/runtime": "^2.7.0"
  }
}
