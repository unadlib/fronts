{
  "name": "@fronts/react",
  "version": "1.0.0-next.1",
  "description": "React application and host adapters for Fronts",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/unadlib/fronts#readme",
  "bugs": {
    "url": "https://github.com/unadlib/fronts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unadlib/fronts.git",
    "directory": "packages/react"
  },
  "keywords": [
    "micro-frontends",
    "module-federation",
    "react",
    "runtime"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fronts/core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
